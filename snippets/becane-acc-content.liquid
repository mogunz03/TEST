{% doc %}
  Content of one accordion block on the product page (sections/product-becane.liquid).

  What it shows, first match wins:
    1. the product description (when the block asks for it)
    2. the product metafield named by the block (e.g. custom.size_chart), whatever its type:
         Rich text / text  -> the text
         File (image)      -> the image (a size chart saved as a picture)
         File (PDF)        -> a download link
         Page              -> the full content of that page
    3. the block's own static content (the same on every product)

  Returns nothing when there is nothing to show, so the caller can hide an empty accordion.

  @param {object} block   - the accordion block
  @param {object} product - the current product
{% enddoc %}
{%- liquid
  if block.settings.use_product_description
    echo product.description
  elsif block.settings.metafield_namespace != blank and block.settings.metafield_key != blank
    assign mf = product.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
    if mf != blank
      case mf.type
        when 'page_reference'
          echo mf.value.content
        when 'file_reference'
          if mf.value.src
            echo mf.value | image_url: width: 1400 | image_tag: loading: 'lazy', alt: block.settings.title
          elsif mf.value.url
            echo '<p><a href="' | append: mf.value.url | append: '" target="_blank" rel="noopener">' | append: block.settings.title | append: ' (PDF)</a></p>'
          endif
        else
          echo mf | metafield_tag
      endcase
    else
      echo block.settings.content
    endif
  else
    echo block.settings.content
  endif
-%}
