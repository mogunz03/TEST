{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{%- liquid
  comment
    Seamless loop + speed in pixels per second.
    The track holds the product list twice and slides left by exactly ONE list
    (n cards + n gaps), so the second copy lands where the first started: no jump.
    (The old version slid by 50% of a box that was hard-coded to 200% of the page width,
    which only lined up by accident, and its "speed" was a duration in seconds, so a
    bigger number meant slower.) Duration = distance / speed.
  endcomment
  assign gap = 20
  assign n = block.settings.product_list.size
  assign speed = block.settings.speed | at_least: 5
  assign set_w = block.settings.card_width | plus: gap | times: n
  assign set_w_m = block.settings.card_width | times: 0.8 | plus: gap | times: n
  assign dur = set_w | times: 1.0 | divided_by: speed | round: 1
  assign dur_m = set_w_m | times: 1.0 | divided_by: speed | round: 1
-%}

{% style %}
  .ai-marquee-carousel-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-marquee-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 30px;
    padding: 0 20px;
  }

  .ai-marquee-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
  }

  .ai-marquee-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-marquee-carousel__track-{{ ai_gen_id }} {
    --ai-set-w: {{ set_w }}px;
    display: flex;
    width: max-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ dur }}s linear infinite;
    gap: {{ gap }}px;
  }

  {% if block.settings.pause_on_hover %}
    .ai-marquee-carousel__track-{{ ai_gen_id }}:hover {
      animation-play-state: paused;
    }
  {% endif %}

  .ai-marquee-carousel__item-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: none;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ai-marquee-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-marquee-carousel__image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease-in-out; /* fade only */
  }

  .ai-marquee-carousel__primary-image-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
  }

  .ai-marquee-carousel__secondary-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    z-index: 2;
  }

  {% if block.settings.show_second_image_on_hover %}
    .ai-marquee-carousel__item-{{ ai_gen_id }}:hover .ai-marquee-carousel__primary-image-{{ ai_gen_id }} {
      opacity: 0;
    }

    .ai-marquee-carousel__item-{{ ai_gen_id }}:hover .ai-marquee-carousel__secondary-image-{{ ai_gen_id }} {
      opacity: 1;
    }
  {% endif %}

  .ai-marquee-carousel__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-marquee-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-marquee-carousel__content-{{ ai_gen_id }} {
    padding: 15px;
  }

  .ai-marquee-carousel__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-marquee-carousel__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 700;
    margin: 0;
  }

  .ai-marquee-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-marquee-carousel__empty-state-{{ ai_gen_id }} h3 {
    margin: 0 0 10px;
    font-size: 18px;
  }

  .ai-marquee-carousel__empty-state-{{ ai_gen_id }} p {
    margin: 0;
    font-size: 14px;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-1 * var(--ai-set-w)));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width | times: 0.8 }}px;
    }

    .ai-marquee-carousel__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-marquee-carousel__track-{{ ai_gen_id }} {
      --ai-set-w: {{ set_w_m }}px;
      animation-duration: {{ dur_m }}s;
    }
  }

  /* visitors who asked for reduced motion get a still strip they can scroll sideways */
  @media (prefers-reduced-motion: reduce) {
    .ai-marquee-carousel__track-{{ ai_gen_id }} { animation: none; }
    .ai-marquee-carousel-{{ ai_gen_id }} { overflow-x: auto; }
  }
{% endstyle %}

<div class="ai-marquee-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.subtitle != blank %}
    <div class="ai-marquee-carousel__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-marquee-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-marquee-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.product_list != blank %}
    <div class="ai-marquee-carousel__track-{{ ai_gen_id }}">
      {% for product in block.settings.product_list %}
        <a class="ai-marquee-carousel__item-{{ ai_gen_id }}" href="{{ product.url }}">
          <div class="ai-marquee-carousel__image-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 400 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="400"
                height="{{ block.settings.image_height }}"
                class="ai-marquee-carousel__primary-image-{{ ai_gen_id }}"
              >
              {% if block.settings.show_second_image_on_hover and product.images[1] %}
                <img
                  src="{{ product.images[1] | image_url: width: 400 }}"
                  alt="{{ product.images[1].alt | escape }}"
                  loading="lazy"
                  width="400"
                  height="{{ block.settings.image_height }}"
                  class="ai-marquee-carousel__secondary-image-{{ ai_gen_id }}"
                >
              {% endif %}
            {% else %}
              <div class="ai-marquee-carousel__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-marquee-carousel__content-{{ ai_gen_id }}">
            <h3 class="ai-marquee-carousel__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
            <div class="ai-marquee-carousel__product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}

      {% for product in block.settings.product_list %}
        <a class="ai-marquee-carousel__item-{{ ai_gen_id }}" href="{{ product.url }}" aria-hidden="true" tabindex="-1">
          <div class="ai-marquee-carousel__image-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 400 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="400"
                height="{{ block.settings.image_height }}"
                class="ai-marquee-carousel__primary-image-{{ ai_gen_id }}"
              >
              {% if block.settings.show_second_image_on_hover and product.images[1] %}
                <img
                  src="{{ product.images[1] | image_url: width: 400 }}"
                  alt="{{ product.images[1].alt | escape }}"
                  loading="lazy"
                  width="400"
                  height="{{ block.settings.image_height }}"
                  class="ai-marquee-carousel__secondary-image-{{ ai_gen_id }}"
                >
              {% endif %}
            {% else %}
              <div class="ai-marquee-carousel__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-marquee-carousel__content-{{ ai_gen_id }}">
            <h3 class="ai-marquee-carousel__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
            <div class="ai-marquee-carousel__product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-marquee-carousel__empty-state-{{ ai_gen_id }}">
      <h3>No products selected</h3>
      <p>Add products to display in the marquee carousel</p>
    </div>
  {% endif %}
</div>

