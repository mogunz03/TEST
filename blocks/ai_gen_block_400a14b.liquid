{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  /* --- ZARA STYLE FULL-WIDTH STACKING LAYOUT --- */
  
  /* 1. Force media container full-width (100vw) */
  .ai-product-media-container-{{ ai_gen_id }} { 
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(50% - 50vw) !important; 
    margin-right: calc(50% - 50vw) !important;
    margin-bottom: 60px !important;
  }

  /* 2. LIMIT THE SIZE OF THE IMAGES INSIDE THE CONTAINER */
  .ai-product-media-gallery-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_image_width }}px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 20px;
  }

  .ai-product-media-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.image_gap }}px;
    width: 100%;
  }

  .ai-product-media-item-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-product-media-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-product-media-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-media-placeholder-{{ ai_gen_id }} svg {
    width: 120px;
    height: 120px;
    color: #ccc;
  }

  /* Ensure the product info block maintains standard page width */
  .ai-product-info-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 20px;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin-bottom: 16px;
    font-weight: 600;
    text-transform: {{ block.settings.title_case }};
    line-height: 1.2;
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin-bottom: 30px;
    font-weight: 500;
  }

  .ai-product-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    color: #999;
    margin-left: 8px;
    font-size: 0.9em;
  }

  .ai-product-form-{{ ai_gen_id }} {
    margin-bottom: 50px;
  }

  .ai-variant-selector-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-variant-selector-{{ ai_gen_id }} label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    text-transform: {{ block.settings.label_case }};
    font-size: 14px;
  }

  .ai-variant-selector-{{ ai_gen_id }} select {
    width: 100%;
    padding: 12px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.text_color }};
    font-size: 16px;
  }

  .ai-add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    text-transform: {{ block.settings.button_case }};
  }

  .ai-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-add-to-cart-{{ ai_gen_id }}:disabled {
    background-color: #cccccc;
    cursor: not-allowed;
  }

  .ai-product-details-{{ ai_gen_id }} {
    margin-top: 50px;
    border-top: 1px solid {{ block.settings.border_color }};
    padding-top: 40px;
  }

  .ai-collapsible-item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.border_color }};
    margin-bottom: 0;
  }

  .ai-collapsible-header-{{ ai_gen_id }} {
    width: 100%;
    padding: 20px 0;
    background: none;
    border: none;
    text-align: left;
    font-size: {{ block.settings.accordion_heading_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-transform: {{ block.settings.accordion_case }};
  }

  .ai-collapsible-icon-{{ ai_gen_id }} {
    transition: transform 0.3s ease;
    width: 16px;
    height: 16px;
  }

  .ai-collapsible-header-{{ ai_gen_id }}[aria-expanded="true"] .ai-collapsible-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-collapsible-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-collapsible-content-{{ ai_gen_id }}.active {
    max-height: 1000px;
    padding-bottom: 20px;
  }

  .ai-collapsible-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    font-size: {{ block.settings.description_text_size }}px;
  }

  .ai-collapsible-text-{{ ai_gen_id }} p {
    margin-bottom: 12px;
  }

  .ai-collapsible-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-product-media-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
    
    .ai-product-media-gallery-{{ ai_gen_id }} {
      max-width: 100%;
      padding: 0 16px;
    }
    
    .ai-product-info-wrapper-{{ ai_gen_id }} {
      padding: 0 16px;
    }
    
    .ai-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-zara-product-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <!-- Product Media Section - Full Width Container with Constrained Images -->
  <div class="ai-product-media-container-{{ ai_gen_id }}">
    <div class="ai-product-media-gallery-{{ ai_gen_id }}">
      {% if product.media.size > 0 %}
        <div class="ai-product-media-grid-{{ ai_gen_id }}">
          {% for media in product.media limit: block.settings.max_images %}
            <div class="ai-product-media-item-{{ ai_gen_id }}">
              {% if media.media_type == 'image' %}
                <img
                  src="{{ media | image_url: width: 800 }}"
                  alt="{{ media.alt | escape }}"
                  loading="lazy"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                >
              {% elsif media.media_type == 'video' %}
                {{ media | video_tag: controls: true, muted: true, loop: true }}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-product-media-grid-{{ ai_gen_id }}">
          {% for i in (1..4) %}
            <div class="ai-product-media-item-{{ ai_gen_id }}">
              <div class="ai-product-media-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Product Information Section - Standard Width -->
  <div class="ai-product-info-wrapper-{{ ai_gen_id }}">
    {% if product.title %}
      <h1 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h1>
    {% endif %}

    {% if product.price %}
      <div class="ai-product-price-{{ ai_gen_id }}">
        {{ product.price | money }}
        {% if product.compare_at_price > product.price %}
          <span class="ai-product-price-compare-{{ ai_gen_id }}">
            {{ product.compare_at_price | money }}
          </span>
        {% endif %}
      </div>
    {% endif %}

    {% if product.variants.size > 1 %}
      <form class="ai-product-form-{{ ai_gen_id }}" action="/cart/add" method="post" enctype="multipart/form-data">
        {% for option in product.options_with_values %}
          <div class="ai-variant-selector-{{ ai_gen_id }}">
            <label for="option-{{ forloop.index }}-{{ ai_gen_id }}">{{ option.name }}</label>
            <select 
              id="option-{{ forloop.index }}-{{ ai_gen_id }}"
              name="options[{{ option.name }}]"
              data-option-index="{{ forloop.index0 }}"
            >
              {% for value in option.values %}
                <option value="{{ value }}" {% if option.selected_value == value %}selected{% endif %}>
                  {{ value }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% endfor %}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        
        <button 
          type="submit" 
          class="ai-add-to-cart-{{ ai_gen_id }}"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
          {% if product.selected_or_first_available_variant.available %}
            {{ block.settings.add_to_cart_text }}
          {% else %}
            Sold out
          {% endif %}
        </button>
      </form>
    {% else %}
      <form class="ai-product-form-{{ ai_gen_id }}" action="/cart/add" method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        
        <button 
          type="submit" 
          class="ai-add-to-cart-{{ ai_gen_id }}"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
          {% if product.selected_or_first_available_variant.available %}
            {{ block.settings.add_to_cart_text }}
          {% else %}
            Sold out
          {% endif %}
        </button>
      </form>
    {% endif %}

    <!-- Product Details Section -->
    <div class="ai-product-details-{{ ai_gen_id }}">
      {% if product.description != blank %}
        <div class="ai-collapsible-item-{{ ai_gen_id }}">
          <button 
            class="ai-collapsible-header-{{ ai_gen_id }}"
            aria-expanded="{% if block.settings.description_open_default %}true{% else %}false{% endif %}"
            data-collapsible-trigger
          >
            {{ block.settings.description_heading }}
            <span class="ai-collapsible-icon-{{ ai_gen_id }}">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>
          <div class="ai-collapsible-content-{{ ai_gen_id }} {% if block.settings.description_open_default %}active{% endif %}">
            <div class="ai-collapsible-text-{{ ai_gen_id }}">
              {{ product.description }}
            </div>
          </div>
        </div>
      {% endif %}

      {% if block.settings.shipping_info != blank %}
        <div class="ai-collapsible-item-{{ ai_gen_id }}">
          <button 
            class="ai-collapsible-header-{{ ai_gen_id }}"
            aria-expanded="false"
            data-collapsible-trigger
          >
            {{ block.settings.shipping_heading }}
            <span class="ai-collapsible-icon-{{ ai_gen_id }}">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>
          <div class="ai-collapsible-content-{{ ai_gen_id }}">
            <div class="ai-collapsible-text-{{ ai_gen_id }}">
              {{ block.settings.shipping_info }}
            </div>
          </div>
        </div>
      {% endif %}

      {% if block.settings.care_info != blank %}
        <div class="ai-collapsible-item-{{ ai_gen_id }}">
          <button 
            class="ai-collapsible-header-{{ ai_gen_id }}"
            aria-expanded="false"
            data-collapsible-trigger
          >
            {{ block.settings.care_heading }}
            <span class="ai-collapsible-icon-{{ ai_gen_id }}">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>
          <div class="ai-collapsible-content-{{ ai_gen_id }}">
            <div class="ai-collapsible-text-{{ ai_gen_id }}">
              {{ block.settings.care_info }}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  (function() {
    class ZaraProductLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupVariantSelector();
        this.setupCollapsibles();
      }

      setupVariantSelector() {
        const selectors = this.querySelectorAll('[data-option-index]');
        const hiddenInput = this.querySelector('input[name="id"]');
        
        if (!selectors.length || !hiddenInput) return;

        selectors.forEach(selector => {
          selector.addEventListener('change', () => {
            const selectedOptions = Array.from(selectors).map(select => select.value);
            const variant = this.findVariantByOptions(selectedOptions);
            
            if (variant) {
              hiddenInput.value = variant.id;
              this.updateButton(variant);
            }
          });
        });
      }

      findVariantByOptions(selectedOptions) {
        return window.product?.variants?.find(variant => {
          return variant.options.every((option, index) => option === selectedOptions[index]);
        });
      }

      updateButton(variant) {
        const button = this.querySelector('.ai-add-to-cart-{{ ai_gen_id }}');
        if (!button) return;

        if (variant.available) {
          button.disabled = false;
          button.textContent = '{{ block.settings.add_to_cart_text }}';
        } else {
          button.disabled = true;
          button.textContent = 'Sold out';
        }
      }

      setupCollapsibles() {
        const triggers = this.querySelectorAll('[data-collapsible-trigger]');
        
        triggers.forEach(trigger => {
          trigger.addEventListener('click', () => {
            const content = trigger.nextElementSibling;
            const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
            
            trigger.setAttribute('aria-expanded', !isExpanded);
            content.classList.toggle('active');
          });
        });
      }
    }

    customElements.define('zara-product-layout-{{ ai_gen_id }}', ZaraProductLayout{{ ai_gen_id }});

    if (typeof window.product === 'undefined' && typeof product !== 'undefined') {
      window.product = {{ product | json }};
    }
  })();
</script>

