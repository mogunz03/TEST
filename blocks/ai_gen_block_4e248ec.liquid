{% doc %}
  @prompt
    Replace or augment the existing header with a floating, pill-shaped sticky navigation bar for both mobile and desktop. Design specs:
    
    1. HEADER BAR: A pill/capsule-shaped floating bar (centered horizontally, fixed/sticky at top with margin), containing:
       - Search icon (magnifying glass) on the far left
       - Centered logo: supports either an image logo or text wordmark, pulled from theme settings
       - Hamburger menu icon (three lines) on the far right
       - White or light background, soft drop shadow, rounded pill shape (border-radius ~50px), no full-width stretch
    
    2. MENU OVERLAY (on hamburger click): Full-screen white overlay with:
       - Hierarchical nav: parent items (from main-menu) with a chevron that expands/collapses child links inline
       - Top-level links listed cleanly below
       - Bottom bar matching the pill header: search icon left, logo center, × close icon right
       - Large clean sans-serif type, generous spacing, no dividers
    
    3. SEARCH MODE: Clicking the search icon morphs the pill bar into a full-width search input field with an × on the left to dismiss and return to default bar state
    
    Works on both mobile and desktop. Smooth CSS transitions for open/close. Pulls navigation from the store's main-menu link list., make it sticky on the bottom with 20px margin, corder radius 10px, glassmorphic, no drop shadow, when i click on the menu botton it needs to expand uppward, not weird shape changes, smooth animation, , nice, as for the glassmorphism add more blur when it expands and the hamburger menu changes to X when expanded, last but not least, it'as always on top, it seems to display foot elements on top of it when scrolling, but all the main menu elemebts in the new pill menu, add the card, the currency change and the login , add a very clean and smooth bluerre soft drop shadown
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pill-header-{{ ai_gen_id }} {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    padding: 0 20px;
    display: block;
    pointer-events: none;
  }

  .ai-pill-header__bar-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: {{ block.settings.bar_background }};
    backdrop-filter: blur({{ block.settings.blur_strength }}px);
    -webkit-backdrop-filter: blur({{ block.settings.blur_strength }}px);
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 10px;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    pointer-events: auto;
    box-shadow: 0 8px 32px {{ block.settings.shadow_color }};
  }

  .ai-pill-header__bar-{{ ai_gen_id }}.menu-active {
    border-radius: 10px;
    max-height: 70vh;
    overflow-y: auto;
    flex-direction: column;
    align-items: stretch;
    backdrop-filter: blur({{ block.settings.blur_strength_expanded }}px);
    -webkit-backdrop-filter: blur({{ block.settings.blur_strength_expanded }}px);
    box-shadow: 0 12px 48px {{ block.settings.shadow_color_expanded }};
  }

  .ai-pill-header__bar-{{ ai_gen_id }}.search-active {
    border-radius: 10px;
  }

  .ai-pill-header__top-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    flex-shrink: 0;
    gap: 15px;
  }

  .ai-pill-header__left-icons-{{ ai_gen_id }},
  .ai-pill-header__right-icons-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .ai-pill-header__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    cursor: pointer;
    color: {{ block.settings.icon_color }};
    transition: color 0.3s ease;
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 0;
    position: relative;
  }

  .ai-pill-header__icon-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
  }

  .ai-pill-header__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-pill-header__cart-count-{{ ai_gen_id }} {
    position: absolute;
    top: -6px;
    right: -6px;
    background: {{ block.settings.cart_badge_bg }};
    color: {{ block.settings.cart_badge_text }};
    font-size: 10px;
    font-weight: 600;
    border-radius: 50%;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .ai-pill-header__menu-icon-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-pill-header__menu-icon-{{ ai_gen_id }} svg {
    transition: opacity 0.3s ease, transform 0.3s ease;
    position: absolute;
    top: 0;
    left: 0;
  }

  .ai-pill-header__menu-hamburger-{{ ai_gen_id }} {
    opacity: 1;
    transform: rotate(0deg);
  }

  .ai-pill-header__menu-close-{{ ai_gen_id }} {
    opacity: 0;
    transform: rotate(90deg);
  }

  .ai-pill-header__bar-{{ ai_gen_id }}.menu-active .ai-pill-header__menu-hamburger-{{ ai_gen_id }} {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .ai-pill-header__bar-{{ ai_gen_id }}.menu-active .ai-pill-header__menu-close-{{ ai_gen_id }} {
    opacity: 1;
    transform: rotate(0deg);
  }

  .ai-pill-header__logo-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-pill-header__logo-image-{{ ai_gen_id }} {
    max-height: {{ block.settings.logo_height }}px;
    width: auto;
  }

  .ai-pill-header__logo-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.logo_text_size }}px;
    font-weight: 600;
    color: {{ block.settings.logo_text_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-pill-header__search-input-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    border: none;
    background: transparent;
    font-size: {{ block.settings.search_font_size }}px;
    color: {{ block.settings.search_text_color }};
    outline: none;
    padding: 0 20px;
  }

  .ai-pill-header__search-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.search_placeholder_color }};
  }

  .ai-pill-header__bar-{{ ai_gen_id }}.search-active .ai-pill-header__search-input-{{ ai_gen_id }} {
    display: block;
  }

  .ai-pill-header__bar-{{ ai_gen_id }}.search-active .ai-pill-header__logo-{{ ai_gen_id }},
  .ai-pill-header__bar-{{ ai_gen_id }}.search-active .ai-pill-header__left-icons-{{ ai_gen_id }},
  .ai-pill-header__bar-{{ ai_gen_id }}.search-active .ai-pill-header__right-icons-{{ ai_gen_id }} {
    display: none;
  }

  .ai-pill-header__close-search-{{ ai_gen_id }} {
    display: none;
  }

  .ai-pill-header__bar-{{ ai_gen_id }}.search-active .ai-pill-header__close-search-{{ ai_gen_id }} {
    display: block;
  }

  .ai-pill-header__nav-{{ ai_gen_id }} {
    width: 100%;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding-top: 0;
  }

  .ai-pill-header__bar-{{ ai_gen_id }}.menu-active .ai-pill-header__nav-{{ ai_gen_id }} {
    max-height: 60vh;
    opacity: 1;
    padding-top: {{ block.settings.nav_top_spacing }}px;
    overflow-y: auto;
  }

  .ai-pill-header__nav-item-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.nav_spacing }}px;
  }

  .ai-pill-header__nav-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: {{ block.settings.nav_font_size }}px;
    color: {{ block.settings.nav_text_color }};
    text-decoration: none;
    padding: {{ block.settings.nav_item_padding }}px 0;
    transition: color 0.3s ease;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-pill-header__nav-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.nav_hover_color }};
  }

  .ai-pill-header__chevron-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .ai-pill-header__chevron-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-pill-header__nav-item-{{ ai_gen_id }}.expanded .ai-pill-header__chevron-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-pill-header__submenu-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    padding-left: 20px;
  }

  .ai-pill-header__nav-item-{{ ai_gen_id }}.expanded .ai-pill-header__submenu-{{ ai_gen_id }} {
    max-height: 1000px;
  }

  .ai-pill-header__submenu-link-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.submenu_font_size }}px;
    color: {{ block.settings.submenu_text_color }};
    text-decoration: none;
    padding: {{ block.settings.submenu_item_padding }}px 0;
    transition: color 0.3s ease;
  }

  .ai-pill-header__submenu-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.submenu_hover_color }};
  }

  .ai-pill-header__menu-bottom-bar-{{ ai_gen_id }} {
    display: none;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-top: {{ block.settings.nav_top_spacing }}px;
    margin-top: {{ block.settings.nav_top_spacing }}px;
    border-top: 1px solid {{ block.settings.border_color }};
  }

  .ai-pill-header__bar-{{ ai_gen_id }}.menu-active .ai-pill-header__menu-bottom-bar-{{ ai_gen_id }} {
    display: flex;
  }

  .ai-pill-header__bottom-left-icons-{{ ai_gen_id }},
  .ai-pill-header__bottom-right-icons-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  @media screen and (max-width: 749px) {
    .ai-pill-header__logo-image-{{ ai_gen_id }} {
      max-height: {{ block.settings.logo_height_mobile }}px;
    }

    .ai-pill-header__logo-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.logo_text_size_mobile }}px;
    }

    .ai-pill-header__nav-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.nav_font_size_mobile }}px;
    }

    .ai-pill-header__submenu-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.submenu_font_size_mobile }}px;
    }
  }
{% endstyle %}

<pill-header-{{ ai_gen_id }} class="ai-pill-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-pill-header__bar-{{ ai_gen_id }}">
    <div class="ai-pill-header__top-row-{{ ai_gen_id }}">
      <div class="ai-pill-header__left-icons-{{ ai_gen_id }}">
        <button class="ai-pill-header__icon-{{ ai_gen_id }} ai-pill-header__search-icon-{{ ai_gen_id }}" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </button>

        <a href="/account" class="ai-pill-header__icon-{{ ai_gen_id }}" aria-label="Account">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      </div>

      <button class="ai-pill-header__icon-{{ ai_gen_id }} ai-pill-header__close-search-{{ ai_gen_id }}" aria-label="Close search">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <input 
        type="text" 
        class="ai-pill-header__search-input-{{ ai_gen_id }}" 
        placeholder="{{ block.settings.search_placeholder }}"
        aria-label="Search"
      >

      <div class="ai-pill-header__logo-{{ ai_gen_id }}">
        {% if settings.logo != blank %}
          <img 
            src="{{ settings.logo | image_url: width: 400 }}" 
            alt="{{ shop.name }}"
            class="ai-pill-header__logo-image-{{ ai_gen_id }}"
            loading="lazy"
          >
        {% else %}
          <span class="ai-pill-header__logo-text-{{ ai_gen_id }}">{{ shop.name }}</span>
        {% endif %}
      </div>

      <div class="ai-pill-header__right-icons-{{ ai_gen_id }}">
        <a href="/cart" class="ai-pill-header__icon-{{ ai_gen_id }}" aria-label="Cart">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="ai-pill-header__cart-count-{{ ai_gen_id }}">{{ cart.item_count }}</span>
          {% endif %}
        </a>

        <button class="ai-pill-header__icon-{{ ai_gen_id }} ai-pill-header__menu-icon-{{ ai_gen_id }}" aria-label="Menu" aria-expanded="false">
          <svg class="ai-pill-header__menu-hamburger-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg class="ai-pill-header__menu-close-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <nav class="ai-pill-header__nav-{{ ai_gen_id }}">
      {% for link in linklists[block.settings.menu].links %}
        <div class="ai-pill-header__nav-item-{{ ai_gen_id }}" data-has-children="{% if link.links.size > 0 %}1{% else %}0{% endif %}">
          {% if link.links.size > 0 %}
            <div class="ai-pill-header__nav-link-{{ ai_gen_id }}">
              <span>{{ link.title }}</span>
              <span class="ai-pill-header__chevron-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </div>
            <div class="ai-pill-header__submenu-{{ ai_gen_id }}">
              {% for child_link in link.links %}
                <a href="{{ child_link.url }}" class="ai-pill-header__submenu-link-{{ ai_gen_id }}">
                  {{ child_link.title }}
                </a>
              {% endfor %}
            </div>
          {% else %}
            <a href="{{ link.url }}" class="ai-pill-header__nav-link-{{ ai_gen_id }}">
              <span>{{ link.title }}</span>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </nav>

    <div class="ai-pill-header__menu-bottom-bar-{{ ai_gen_id }}">
      <div class="ai-pill-header__bottom-left-icons-{{ ai_gen_id }}">
        <button class="ai-pill-header__icon-{{ ai_gen_id }} ai-pill-header__search-icon-bottom-{{ ai_gen_id }}" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </button>

        <a href="/account" class="ai-pill-header__icon-{{ ai_gen_id }}" aria-label="Account">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      </div>

      <div class="ai-pill-header__logo-{{ ai_gen_id }}">
        {% if settings.logo != blank %}
          <img 
            src="{{ settings.logo | image_url: width: 400 }}" 
            alt="{{ shop.name }}"
            class="ai-pill-header__logo-image-{{ ai_gen_id }}"
            loading="lazy"
          >
        {% else %}
          <span class="ai-pill-header__logo-text-{{ ai_gen_id }}">{{ shop.name }}</span>
        {% endif %}
      </div>

      <div class="ai-pill-header__bottom-right-icons-{{ ai_gen_id }}">
        <a href="/cart" class="ai-pill-header__icon-{{ ai_gen_id }}" aria-label="Cart">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="ai-pill-header__cart-count-{{ ai_gen_id }}">{{ cart.item_count }}</span>
          {% endif %}
        </a>

        <button class="ai-pill-header__icon-{{ ai_gen_id }} ai-pill-header__menu-close-bottom-{{ ai_gen_id }}" aria-label="Close menu">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>
</pill-header-{{ ai_gen_id }}>

<script>
  (function() {
    class PillHeader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.bar = this.querySelector('.ai-pill-header__bar-{{ ai_gen_id }}');
        this.searchIcon = this.querySelector('.ai-pill-header__search-icon-{{ ai_gen_id }}');
        this.searchIconBottom = this.querySelector('.ai-pill-header__search-icon-bottom-{{ ai_gen_id }}');
        this.closeSearchIcon = this.querySelector('.ai-pill-header__close-search-{{ ai_gen_id }}');
        this.searchInput = this.querySelector('.ai-pill-header__search-input-{{ ai_gen_id }}');
        this.menuIcon = this.querySelector('.ai-pill-header__menu-icon-{{ ai_gen_id }}');
        this.menuCloseBottom = this.querySelector('.ai-pill-header__menu-close-bottom-{{ ai_gen_id }}');
        this.navItems = this.querySelectorAll('.ai-pill-header__nav-item-{{ ai_gen_id }}');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.searchIcon.addEventListener('click', () => this.openSearch());
        this.searchIconBottom.addEventListener('click', () => this.openSearch());
        this.closeSearchIcon.addEventListener('click', () => this.closeSearch());
        this.menuIcon.addEventListener('click', () => this.toggleMenu());
        this.menuCloseBottom.addEventListener('click', () => this.closeMenu());

        this.navItems.forEach(item => {
          const hasChildren = item.getAttribute('data-has-children') === '1';
          if (hasChildren) {
            const link = item.querySelector('.ai-pill-header__nav-link-{{ ai_gen_id }}');
            link.addEventListener('click', (e) => {
              e.preventDefault();
              item.classList.toggle('expanded');
            });
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            this.closeSearch();
            this.closeMenu();
          }
        });
      }

      openSearch() {
        this.closeMenu();
        this.bar.classList.add('search-active');
        this.searchInput.focus();
      }

      closeSearch() {
        this.bar.classList.remove('search-active');
        this.searchInput.value = '';
      }

      toggleMenu() {
        const isActive = this.bar.classList.contains('menu-active');
        if (isActive) {
          this.closeMenu();
        } else {
          this.openMenu();
        }
      }

      openMenu() {
        this.closeSearch();
        this.bar.classList.add('menu-active');
        this.menuIcon.setAttribute('aria-expanded', 'true');
      }

      closeMenu() {
        this.bar.classList.remove('menu-active');
        this.menuIcon.setAttribute('aria-expanded', 'false');
        this.navItems.forEach(item => {
          item.classList.remove('expanded');
        });
      }
    }

    customElements.define('pill-header-{{ ai_gen_id }}', PillHeader{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Pill header",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Pill bar style"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "color",
      "id": "bar_background",
      "label": "Background",
      "default": "rgba(255, 255, 255, 0.2)"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "rgba(255, 255, 255, 0.3)"
    },
    {
      "type": "range",
      "id": "blur_strength",
      "label": "Blur strength",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },
