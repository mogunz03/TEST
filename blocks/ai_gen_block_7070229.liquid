{% doc %}
  @prompt
    create a  marquee carousel showing each product  only display each items once, prdouct card no shadow on hover, show product second imag eon hover, no product card background,select products not collection, product card no shadow, full width, , only product name align left ,no price ，no button view product
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-carousel-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .ai-marquee-track-{{ ai_gen_id }} {
    display: flex;
    width: max-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    gap: {{ block.settings.product_spacing }}px;
  }

  .ai-marquee-carousel-{{ ai_gen_id }}:hover .ai-marquee-track-{{ ai_gen_id }} {
    animation-play-state: {% if block.settings.pause_on_hover %}paused{% else %}running{% endif %};
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-product-card-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.product_width }}px;
    position: relative;
    cursor: pointer;
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    margin-bottom: {{ block.settings.title_spacing }}px;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .ai-product-image-secondary-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-image-secondary-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-image-{{ ai_gen_id }} {
    opacity: 0;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-align: left;
    margin: 0;
    line-height: 1.3;
    text-transform: {% if block.settings.title_uppercase %}uppercase{% else %}none{% endif %};
  }

  .ai-product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-product-card-{{ ai_gen_id }} {
      width: {{ block.settings.product_width | times: 0.8 }}px;
    }
    
    .ai-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<marquee-carousel-{{ ai_gen_id }}
  class="ai-marquee-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-marquee-track-{{ ai_gen_id }}">
    {% liquid
      assign products_to_show = block.settings.selected_products
      assign products_count = products_to_show.size
      
      if products_count == 0
        assign products_to_show = collections.all.products | limit: 8
        assign products_count = 8
      endif
      
      assign duplicate_count = 2
      if products_count < 6
        assign duplicate_count = 3
      endif
    %}

    {% for i in (1..duplicate_count) %}
      {% for product in products_to_show %}
        <div class="ai-product-card-{{ ai_gen_id }}">
          <a href="{{ product.url }}" class="ai-product-link-{{ ai_gen_id }}">
            <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | divided_by: block.settings.image_aspect_ratio | round }}"
                >
                
                {% if product.images[1] %}
                  <img
                    src="{{ product.images[1] | image_url: width: 600 }}"
                    alt="{{ product.images[1].alt | escape }}"
                    class="ai-product-image-secondary-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ 600 | divided_by: block.settings.image_aspect_ratio | round }}"
                  >
                {% endif %}
              {% else %}
                <div class="ai-product-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            
            <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
          </a>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</marquee-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class MarqueeCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-marquee-track-{{ ai_gen_id }}');
        this.setupMarquee();
      }

      setupMarquee() {
        if (!this.track) return;
        
        const trackWidth = this.track.scrollWidth;
        const containerWidth = this.offsetWidth;
        
        if (trackWidth <= containerWidth * 2) {
          this.duplicateContent();
        }
      }

      duplicateContent() {
        const originalContent = this.track.innerHTML;
        this.track.innerHTML = originalContent + originalContent;
      }
    }

    customElements.define('marquee-carousel-{{ ai_gen_id }}', MarqueeCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product marquee carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product_list",
      "id": "selected_products",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "product_width",
      "min": 150,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Product width",
      "default": 250
    },
    {
      "type": "range",
      "id": "product_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Product spacing",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1",
          "label": "Square (1:1)"
        },
        {
          "value": "1.25",
          "label": "Portrait (4:5)"
        },
        {
          "value": "1.33",
          "label": "Landscape (4:3)"
        },
        {
          "value": "1.77",
          "label": "Wide (16:9)"
        }
      ],
      "default": "1.25"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Product title"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Title spacing",
      "default": 12
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "title_uppercase",
      "label": "Uppercase title",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Product marquee carousel"
    }
  ]
}
{% endschema %}