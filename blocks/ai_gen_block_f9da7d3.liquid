{% doc %}
  @prompt
    Create a sticky "Add to Cart" bar fixed to the bottom of the product page. It should sit 20px above the existing floating pill-shaped navigation menu (which is already present on the page). The bar should be full-width, dark/black background, with the product price displayed on the right and an "ADD TO CART" label on the left — matching a minimal editorial streetwear aesthetic. It should only appear on product pages and should not overlap or interfere with the pill nav menu., make it almost same size as the pill menu by 5% and same coroder radius as the pillmenu,solid white
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sticky-atc-bar-{{ ai_gen_id }} {
    position: fixed;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%) translateY(100%);
    width: 95%;
    max-width: 95%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    z-index: 999;
    display: block;
    transition: transform 0.3s ease;
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-sticky-atc-bar-{{ ai_gen_id }}.visible {
    transform: translateX(-50%) translateY(0);
  }

  .ai-sticky-atc-bar-content-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-sticky-atc-bar-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.label_font.family }}, {{ block.settings.label_font.fallback_families }};
    font-weight: {{ block.settings.label_font.weight }};
    font-size: {{ block.settings.label_font_size }}px;
    letter-spacing: {{ block.settings.label_letter_spacing }}px;
    text-transform: {{ block.settings.label_text_transform }};
    margin: 0;
  }

  .ai-sticky-atc-bar-price-{{ ai_gen_id }} {
    font-family: {{ block.settings.price_font.family }}, {{ block.settings.price_font.fallback_families }};
    font-weight: {{ block.settings.price_font.weight }};
    font-size: {{ block.settings.price_font_size }}px;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-sticky-atc-bar-{{ ai_gen_id }} {
      bottom: {{ block.settings.mobile_bottom_offset }}px;
    }

    .ai-sticky-atc-bar-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_font_size | times: 0.9 }}px;
    }

    .ai-sticky-atc-bar-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<sticky-atc-bar-{{ ai_gen_id }}
  class="ai-sticky-atc-bar-{{ ai_gen_id }}"
  data-scroll-threshold="{{ block.settings.scroll_threshold }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-sticky-atc-bar-content-{{ ai_gen_id }}">
    <div class="ai-sticky-atc-bar-label-{{ ai_gen_id }}">
      {{ block.settings.button_label }}
    </div>
    <div class="ai-sticky-atc-bar-price-{{ ai_gen_id }}">
      {% if product %}
        {{ product.selected_or_first_available_variant.price | money }}
      {% endif %}
    </div>
  </div>
</sticky-atc-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class StickyAtcBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scrollThreshold = parseInt(this.dataset.scrollThreshold) || 300;
        this.isVisible = false;
      }

      connectedCallback() {
        this.handleScroll = this.handleScroll.bind(this);
        this.handleClick = this.handleClick.bind(this);
        
        window.addEventListener('scroll', this.handleScroll);
        this.addEventListener('click', this.handleClick);
        
        this.handleScroll();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.handleScroll);
        this.removeEventListener('click', this.handleClick);
      }

      handleScroll() {
        const scrollPosition = window.scrollY;
        
        if (scrollPosition > this.scrollThreshold && !this.isVisible) {
          this.classList.add('visible');
          this.isVisible = true;
        } else if (scrollPosition <= this.scrollThreshold && this.isVisible) {
          this.classList.remove('visible');
          this.isVisible = false;
        }
      }

      handleClick() {
        const addToCartButton = document.querySelector('form[action*="/cart/add"] button[type="submit"]');
        
        if (addToCartButton) {
          addToCartButton.click();
        }
      }
    }

    customElements.define('sticky-atc-bar-{{ ai_gen_id }}', StickyAtcBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Sticky add to cart bar",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "ADD TO CART"
    },
    {
      "type": "range",
      "id": "scroll_threshold",
      "label": "Scroll threshold",
      "min": 100,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 300,
      "info": "Distance to scroll before bar appears"
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "range",
      "id": "mobile_bottom_offset",
      "label": "Mobile bottom offset",
      "min": 60,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80,
      "info": "Distance from bottom on mobile to avoid pill nav"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Label typography"
    },
    {
      "type": "font_picker",
      "id": "label_font",
      "label": "Font",
      "default": "barlow_condensed_n6"
    },
    {
      "type": "range",
      "id": "label_font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "label_letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "label_text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Price typography"
    },
    {
      "type": "font_picker",
      "id": "price_font",
      "label": "Font",
      "default": "montserrat_n5"
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Sticky add to cart bar"
    }
  ]
}
{% endschema %}
