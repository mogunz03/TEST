{% comment %}
  Becane Document Page
  File: sections/page-document.liquid
  Use for: legal pages — Refund and Return, Privacy Policy, Shipping Policy, Terms of Services.

  Renders the page's content directly so admins edit the page in the normal Shopify
  page editor. Layout, header and typography all come from the shared page frame in
  snippets/dauze-tokens.liquid, so this page looks identical to every other text page
  (pages, Shopify policy pages): title pinned at the top, only the body scrolls.
{% endcomment %}

<div id="pd-{{ section.id }}">

  <header class="dz-head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="dz-head__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.show_title -%}
      <h1 class="dz-head__title">{{ page.title }}</h1>
    {%- endif -%}

    {%- if section.settings.show_updated_date and page.updated_at != blank -%}
      <p class="dz-head__meta">
        {{ section.settings.updated_label | default: 'Last updated' }} {{ page.updated_at | date: '%b %-d, %Y' }}
      </p>
    {%- endif -%}
  </header>

  <div class="dz-body">
    <div class="dz-prose">
      {{ page.content }}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "Becane document",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LEGAL" },
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true },
    { "type": "checkbox", "id": "show_updated_date", "label": "Show last-updated date", "default": true },
    { "type": "text", "id": "updated_label", "label": "Updated label", "default": "LAST UPDATED" }
  ],
  "presets": [
    { "name": "Becane document", "category": "Page" }
  ]
}
{% endschema %}
