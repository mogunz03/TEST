{% doc %}
  @prompt
    "Design an extremely minimal, luxury, and technologically refined Shopify homepage, modeled after the structure and aesthetic of buildinamsterdam.com.
    
    Focus on:
    
    Extreme Whitespace: Utilize a strict, asymmetric grid layout with abundant whitespace to emphasize content blocks and product imagery.
    
    Typography: Use oversized, all-caps sans-serif typefaces for headlines, creating a bold, statement-making effect.
    
    Monochromatic Palette: Maintain a clean, monochromatic color scheme (black, white, and shades of gray) allowing product visuals to provide the only color accents.
    
    Interactivity: Ensure the design has a highly dynamic and interactive feel, using smooth transitions, cursor-driven effects, and large, clickable link/product blocks for a premium user experience.
    
    Adapt the agency's work section to showcase my products in featured Collection Blocks and replace the "Expertise" section with a clean, grid-based presentation of Featured Products."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-homepage-{{ ai_gen_id }} {
    min-height: 100vh;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    position: relative;
    overflow: hidden;
  }

  .ai-luxury-homepage-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 40px;
    position: relative;
    z-index: 2;
  }

  .ai-luxury-homepage-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    min-height: 80vh;
    align-items: center;
  }

  .ai-luxury-homepage-content-{{ ai_gen_id }} {
    padding-right: {{ block.settings.content_spacing }}px;
  }

  .ai-luxury-homepage-hero-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: clamp({{ block.settings.hero_title_size | times: 0.6 }}px, 8vw, {{ block.settings.hero_title_size }}px);
    line-height: 0.85;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 {{ block.settings.title_margin }}px 0;
    color: {{ block.settings.hero_title_color }};
  }

  .ai-luxury-homepage-hero-subtitle-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.4;
    margin: 0 0 {{ block.settings.subtitle_margin }}px 0;
    color: {{ block.settings.subtitle_color }};
    max-width: 400px;
  }

  .ai-luxury-homepage-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_y }}px {{ block.settings.button_padding_x }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_font_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .ai-luxury-homepage-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-luxury-homepage-hero-image-{{ ai_gen_id }} {
    position: relative;
    height: 70vh;
    min-height: 500px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ai-luxury-homepage-hero-image-{{ ai_gen_id }}:hover {
    transform: scale(1.02);
  }

  .ai-luxury-homepage-hero-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ai-luxury-homepage-hero-image-{{ ai_gen_id }}:hover img {
    transform: scale(1.05);
  }

  .ai-luxury-homepage-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-luxury-homepage-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-luxury-homepage-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    text-align: center;
  }

  .ai-luxury-homepage-collections-{{ ai_gen_id }} {
    margin-top: {{ block.settings.collections_margin }}px;
    padding: {{ block.settings.collections_padding }}px 0;
  }

  .ai-luxury-homepage-collections-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.collections_title_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 {{ block.settings.collections_title_margin }}px 0;
    color: {{ block.settings.collections_title_color }};
  }

  .ai-luxury-homepage-collections-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: {{ block.settings.collections_gap }}px;
  }

  .ai-luxury-homepage-collection-card-{{ ai_gen_id }} {
    position: relative;
    height: 400px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    background-color: {{ block.settings.card_bg_color }};
  }

  .ai-luxury-homepage-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
  }

  .ai-luxury-homepage-collection-card-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ai-luxury-homepage-collection-card-{{ ai_gen_id }}:hover img {
    transform: scale(1.1);
  }

  .ai-luxury-homepage-collection-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
    padding: 40px 30px 30px;
    color: white;
  }

  .ai-luxury-homepage-collection-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.collection_card_title_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 8px 0;
  }

  .ai-luxury-homepage-collection-count-{{ ai_gen_id }} {
    font-size: 14px;
    opacity: 0.8;
  }

  .ai-luxury-homepage-products-{{ ai_gen_id }} {
    margin-top: {{ block.settings.products_margin }}px;
    padding: {{ block.settings.products_padding }}px 0;
  }

  .ai-luxury-homepage-products-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.products_title_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 {{ block.settings.products_title_margin }}px 0;
    color: {{ block.settings.products_title_color }};
  }

  .ai-luxury-homepage-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: {{ block.settings.products_gap }}px;
  }

  .ai-luxury-homepage-product-card-{{ ai_gen_id }} {
    position: relative;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    background-color: {{ block.settings.product_card_bg_color }};
  }

  .ai-luxury-homepage-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-luxury-homepage-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 350px;
    overflow: hidden;
    position: relative;
  }

  .ai-luxury-homepage-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ai-luxury-homepage-product-card-{{ ai_gen_id }}:hover .ai-luxury-homepage-product-image-{{ ai_gen_id }} img {
    transform: scale(1.05);
  }

  .ai-luxury-homepage-product-info-{{ ai_gen_id }} {
    padding: 20px 0;
  }

  .ai-luxury-homepage-product-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.product_title_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 8px 0;
    color: {{ block.settings.product_title_color }};
  }

  .ai-luxury-homepage-product-price-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 500;
  }

  .ai-luxury-homepage-product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-luxury-homepage-product-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  @media screen and (max-width: 1024px) {
    .ai-luxury-homepage-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 60px;
      text-align: center;
    }

    .ai-luxury-homepage-content-{{ ai_gen_id }} {
      padding-right: 0;
      order: 2;
    }

    .ai-luxury-homepage-hero-image-{{ ai_gen_id }} {
      order: 1;
      height: 50vh;
      min-height: 400px;
    }

    .ai-luxury-homepage-container-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 20px;
    }
  }

  @media screen and (max-width: 768px) {
    .ai-luxury-homepage-collections-grid-{{ ai_gen_id }},
    .ai-luxury-homepage-products-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-luxury-homepage-hero-title-{{ ai_gen_id }} {
      font-size: clamp({{ block.settings.hero_title_size | times: 0.4 }}px, 12vw, {{ block.settings.hero_title_size | times: 0.7 }}px);
    }
  }
{% endstyle %}

<luxury-homepage-{{ ai_gen_id }}
  class="ai-luxury-homepage-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-luxury-homepage-container-{{ ai_gen_id }}">
    <div class="ai-luxury-homepage-grid-{{ ai_gen_id }}">
      <div class="ai-luxury-homepage-content-{{ ai_gen_id }}">
        {% if block.settings.hero_title != blank %}
          <h1 class="ai-luxury-homepage-hero-title-{{ ai_gen_id }}">
            {{ block.settings.hero_title }}
          </h1>
        {% endif %}

        {% if block.settings.hero_subtitle != blank %}
          <p class="ai-luxury-homepage-hero-subtitle-{{ ai_gen_id }}">
            {{ block.settings.hero_subtitle }}
          </p>
        {% endif %}

        {% if block.settings.cta_text != blank %}
          <a
            href="{{ block.settings.cta_link | default: '#' }}"
            class="ai-luxury-homepage-cta-{{ ai_gen_id }}"
          >
            {{ block.settings.cta_text }}
          </a>
        {% endif %}
      </div>

      <div class="ai-luxury-homepage-hero-image-{{ ai_gen_id }}">
        {% if block.settings.hero_image %}
          <img
            src="{{ block.settings.hero_image | image_url: width: 1200 }}"
            alt="{{ block.settings.hero_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.hero_image.width }}"
            height="{{ block.settings.hero_image.height }}"
          >
        {% else %}
          <div class="ai-luxury-homepage-image-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-luxury-homepage-empty-state-{{ ai_gen_id }}">
              Add a hero image to complete the look
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    {% if block.settings.show_collections %}
      <div class="ai-luxury-homepage-collections-{{ ai_gen_id }}">
        {% if block.settings.collections_title != blank %}
          <h2 class="ai-luxury-homepage-collections-title-{{ ai_gen_id }}">
            {{ block.settings.collections_title }}
          </h2>
        {% endif %}

        <div class="ai-luxury-homepage-collections-grid-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            {% liquid
              assign collection_key = 'featured_collection_' | append: i
              assign collection = block.settings[collection_key]
            %}

            {% if collection != blank %}
              <a
                href="{{ collection.url }}"
                class="ai-luxury-homepage-collection-card-{{ ai_gen_id }}"
              >
                {% if collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 600 }}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="400"
                  >
                {% else %}
                  <div class="ai-luxury-homepage-image-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                <div class="ai-luxury-homepage-collection-overlay-{{ ai_gen_id }}">
                  <h3 class="ai-luxury-homepage-collection-title-{{ ai_gen_id }}">
                    {{ collection.title }}
                  </h3>
                  <p class="ai-luxury-homepage-collection-count-{{ ai_gen_id }}">
                    {{ collection.products_count }} 
                    {% if collection.products_count == 1 %}product{% else %}products{% endif %}
                  </p>
                </div>
              </a>
            {% else %}
              <div class="ai-luxury-homepage-collection-card-{{ ai_gen_id }}">
                <div class="ai-luxury-homepage-image-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
                <div class="ai-luxury-homepage-collection-overlay-{{ ai_gen_id }}">
                  <h3 class="ai-luxury-homepage-collection-title-{{ ai_gen_id }}">
                    Collection {{ i }}
                  </h3>
                  <p class="ai-luxury-homepage-collection-count-{{ ai_gen_id }}">
                    Select a collection
                  </p>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_products %}
      <div class="ai-luxury-homepage-products-{{ ai_gen_id }}">
        {% if block.settings.products_title != blank %}
          <h2 class="ai-luxury-homepage-products-title-{{ ai_gen_id }}">
            {{ block.settings.products_title }}
          </h2>
        {% endif %}

        <div class="ai-luxury-homepage-products-grid-{{ ai_gen_id }}">
          {% for i in (1..4) %}
            {% liquid
              assign product_key = 'featured_product_' | append: i
              assign product = block.settings[product_key]
            %}

            {% if product != blank %}
              <a
                href="{{ product.url }}"
                class="ai-luxury-homepage-product-card-{{ ai_gen_id }}"
              >
                <div class="ai-luxury-homepage-product-image-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 500 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="500"
                      height="350"
                    >
                  {% else %}
                    <div class="ai-luxury-homepage-product-placeholder-{{ ai_gen_id }}">
                      {{ 'product-apparel-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>

                <div class="ai-luxury-homepage-product-info-{{ ai_gen_id }}">
                  <h3 class="ai-luxury-homepage-product-title-{{ ai_gen_id }}">
                    {{ product.title }}
                  </h3>
                  <p class="ai-luxury-homepage-product-price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </p>
                </div>
              </a>
            {% else %}
              <div class="ai-luxury-homepage-product-card-{{ ai_gen_id }}">
                <div class="ai-luxury-homepage-product-image-{{ ai_gen_id }}">
                  <div class="ai-luxury-homepage-product-placeholder-{{ ai_gen_id }}">
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  </div>
                </div>
                <div class="ai-luxury-homepage-product-info-{{ ai_gen_id }}">
                  <h3 class="ai-luxury-homepage-product-title-{{ ai_gen_id }}">
                    Product {{ i }}
                  </h3>
                  <p class="ai-luxury-homepage-product-price-{{ ai_gen_id }}">
                    Select a product
                  </p>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</luxury-homepage-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxuryHomepage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupInteractivity();
        this.setupCursorEffects();
      }

      setupInteractivity() {
        const cards = this.querySelectorAll(
          '.ai-luxury-homepage-collection-card-{{ ai_gen_id }}, .ai-luxury-homepage-product-card-{{ ai_gen_id }}'
        );

        cards.forEach(card => {
          card.addEventListener('mouseenter', () => {
            card.style.transform = card.classList.contains('ai-luxury-homepage-collection-card-{{ ai_gen_id }}') 
              ? 'translateY(-8px)' 
              : 'translateY(-4px)';
          });

          card.addEventListener('mouseleave', () => {
            card.style.transform = 'translateY(0)';
          });
        });

        const heroImage = this.querySelector('.ai-luxury-homepage-hero-image-{{ ai_gen_id }}');
        if (heroImage) {
          heroImage.addEventListener('mouseenter', () => {
            heroImage.style.transform = 'scale(1.02)';
          });

          heroImage.addEventListener('mouseleave', () => {
            heroImage.style.transform = 'scale(1)';
          });
        }
      }

      setupCursorEffects() {
        const interactiveElements = this.querySelectorAll(
          '.ai-luxury-homepage-cta-{{ ai_gen_id }}, .ai-luxury-homepage-collection-card-{{ ai_gen_id }}, .ai-luxury-homepage-product-card-{{ ai_gen_id }}, .ai-luxury-homepage-hero-image-{{ ai_gen_id }}'
        );

        interactiveElements.forEach(element => {
          element.addEventListener('mouseenter', () => {
            document.body.style.cursor = 'pointer';
          });

          element.addEventListener('mouseleave', () => {
            document.body.style.cursor = 'default';
          });
        });
      }
    }

    customElements.define('luxury-homepage-{{ ai_gen_id }}', LuxuryHomepage{{ ai_gen_id }});
  })();
</script>

