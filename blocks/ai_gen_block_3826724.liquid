{% doc %}
  @prompt
    Design and implement an auto-animated "Recommended Products" section for the Shopify product page of the Doona Coat Feather (https://www.entirestudios.com/product/doona-coat-feather). The section should dynamically showcase complementary products to encourage cross-selling, maintaining Entire Studios' brand values of quality, affordability, functionality, and design. Use the following details and requirements to guide the implementation:
    
    
    
    
    
    Product Context:
    
    
    
    
    
    The Doona Coat Feather is a high-quality, luxury outerwear piece available in multiple sizes (XXS to XL) with measurements provided (e.g., Total Length, Neck Circumference, Chest Circumference).
    
    
    
    The page already references styled-with products: Wide Pleated Trouser Black and Gres Dress Stone.
    
    
    
    Section Requirements:
    
    
    
    
    
    Location: Place the "Recommended Products" section below the product details and sizing chart, but above the footer.
    
    
    
    Animation: Implement a smooth, auto-scrolling carousel or grid that cycles through recommended products every 5 seconds, with hover/pause functionality for user interaction.
    
    
    
    Products to Include:
    
    
    
    
    
    Wide Pleated Trouser Black
    
    
    
    Gres Dress Stone
    
    
    
    Additional complementary Entire Studios items (e.g., other outerwear like the A7L Puffer or Wellington Coat, or accessories) that align with the Doona Coat Feather’s aesthetic and functionality.
    
    
    
    Product Details: For each recommended product, display:
    
    
    
    
    
    Product image (high-resolution, consistent with Entire Studios’ minimalist and luxurious visual style).
    
    
    
    Product name (e.g., "Wide Pleated Trouser Black").
    
    
    
    Price (if available, or a "View Product" call-to-action if price is dynamic).
    
    
    
    A subtle "Add to Bag" or "Select Size" button/link.
    
    
    
    Design:
    
    
    
    
    
    Use a clean, minimalist layout with a focus on high-quality imagery and typography that matches Entire Studios’ brand (e.g., sans-serif fonts, neutral color palette).
    
    
    
    Ensure responsiveness for mobile, tablet, and desktop views.
    
    
    
    Incorporate subtle hover eff

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-recommended-products-{{ ai_gen_id }} {
    padding: 60px 0;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-recommended-products__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-recommended-products__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-recommended-products__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    font-weight: 400;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .ai-recommended-products__carousel-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-recommended-products__carousel-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }

  .ai-recommended-products__carousel-{{ ai_gen_id }}.paused {
    animation-play-state: paused;
  }

  .ai-recommended-products__product-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - 20px);
    margin-right: 30px;
    background-color: {{ block.settings.card_background_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-recommended-products__product-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .ai-recommended-products__product-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    background-color: #f8f8f8;
  }

  .ai-recommended-products__product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-recommended-products__product-{{ ai_gen_id }}:hover .ai-recommended-products__product-image-{{ ai_gen_id }} img {
    transform: scale(1.05);
  }

  .ai-recommended-products__product-info-{{ ai_gen_id }} {
    padding: 24px 0;
    text-align: center;
  }

  .ai-recommended-products__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px;
    font-weight: 400;
    letter-spacing: 0.3px;
    line-height: 1.3;
  }

  .ai-recommended-products__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.price_color }};
    margin: 0 0 16px;
    font-weight: 300;
  }

  .ai-recommended-products__product-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border: 1px solid {{ block.settings.button_border_color }};
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    font-weight: 400;
  }

  .ai-recommended-products__product-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-recommended-products__navigation-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
  }

  .ai-recommended-products__nav-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_dot_color }};
    opacity: 0.3;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-recommended-products__nav-dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  .ai-recommended-products__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
  }

  .ai-recommended-products__empty-title-{{ ai_gen_id }} {
    font-size: 18px;
    margin-bottom: 8px;
    color: #666;
  }

  .ai-recommended-products__empty-text-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.5;
  }

  @media screen and (max-width: 990px) {
    .ai-recommended-products__product-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 15px);
      margin-right: 20px;
    }

    .ai-recommended-products-{{ ai_gen_id }} {
      padding: 40px 0;
    }

    .ai-recommended-products__container-{{ ai_gen_id }} {
      padding: 0 15px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-recommended-products__product-{{ ai_gen_id }} {
      flex: 0 0 calc(100% - 10px);
      margin-right: 15px;
    }

    .ai-recommended-products__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-recommended-products__product-info-{{ ai_gen_id }} {
      padding: 16px 0;
    }
  }
{% endstyle %}

<recommended-products-{{ ai_gen_id }}
  class="ai-recommended-products-{{ ai_gen_id }}"
  data-auto-scroll="{{ block.settings.auto_scroll }}"
  data-scroll-speed="{{ block.settings.scroll_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-recommended-products__container-{{ ai_gen_id }}">
    <div class="ai-recommended-products__header-{{ ai_gen_id }}">
      <h2 class="ai-recommended-products__title-{{ ai_gen_id }}">
        {{ block.settings.section_title }}
      </h2>
    </div>

    {% assign products_list = block.settings.products_list %}
    {% if products_list.size > 0 %}
      <div class="ai-recommended-products__carousel-container-{{ ai_gen_id }}">
        <div class="ai-recommended-products__carousel-{{ ai_gen_id }}">
          {% for product in products_list %}
            <div class="ai-recommended-products__product-{{ ai_gen_id }}">
              <div class="ai-recommended-products__product-image-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="800"
                  >
                {% else %}
                  <div class="ai-recommended-products__placeholder-{{ ai_gen_id }}">
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-recommended-products__product-info-{{ ai_gen_id }}">
                <h3 class="ai-recommended-products__product-title-{{ ai_gen_id }}">
                  {{ product.title }}
                </h3>
                <div class="ai-recommended-products__product-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </div>
                <a
                  href="{{ product.url }}"
                  class="ai-recommended-products__product-button-{{ ai_gen_id }}"
                >
                  {{ block.settings.button_text }}
                </a>
              </div>
            </div>
          {% endfor %}
          {% for product in products_list %}
            <div class="ai-recommended-products__product-{{ ai_gen_id }}">
              <div class="ai-recommended-products__product-image-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="800"
                  >
                {% else %}
                  <div class="ai-recommended-products__placeholder-{{ ai_gen_id }}">
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-recommended-products__product-info-{{ ai_gen_id }}">
                <h3 class="ai-recommended-products__product-title-{{ ai_gen_id }}">
                  {{ product.title }}
                </h3>
                <div class="ai-recommended-products__product-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </div>
                <a
                  href="{{ product.url }}"
                  class="ai-recommended-products__product-button-{{ ai_gen_id }}"
                >
                  {{ block.settings.button_text }}
                </a>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if products_list.size > 3 %}
        <div class="ai-recommended-products__navigation-{{ ai_gen_id }}">
          {% for i in (1..products_list.size) %}
            <button
              class="ai-recommended-products__nav-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
              data-slide="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
      <div class="ai-recommended-products__empty-state-{{ ai_gen_id }}">
        <h3 class="ai-recommended-products__empty-title-{{ ai_gen_id }}">No products selected</h3>
        <p class="ai-recommended-products__empty-text-{{ ai_gen_id }}">
          Add products to showcase your recommended items.<br>
          Select up to 8 products to create an engaging carousel experience.
        </p>
      </div>
    {% endif %}
  </div>
</recommended-products-{{ ai_gen_id }}><script>
  (function() {
    class RecommendedProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoScrollInterval = null;
        this.isHovered = false;
      }

      connectedCallback() {
        this.carousel = this.querySelector('.ai-recommended-products__carousel-{{ ai_gen_id }}');
        this.products = this.querySelectorAll('.ai-recommended-products__product-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-recommended-products__nav-dot-{{ ai_gen_id }}');
        
        this.autoScroll = this.dataset.autoScroll === 'true';
        this.scrollSpeed = parseInt(this.dataset.scrollSpeed) * 1000;
        
        this.totalProducts = this.products.length / 2;
        
        if (this.totalProducts <= 3) {
          this.style.setProperty('--products-per-view', this.totalProducts);
          return;
        }

        this.setupEventListeners();
        this.updateCarousel();
        
        if (this.autoScroll) {
          this.startAutoScroll();
        }
      }

      setupEventListeners() {
        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
          });
        });

        this.addEventListener('mouseenter', () => {
          this.isHovered = true;
          this.pauseAutoScroll();
        });

        this.addEventListener('mouseleave', () => {
          this.isHovered = false;
          if (this.autoScroll) {
            this.startAutoScroll();
          }
        });

        let touchStartX = 0;
        let touchEndX = 0;

        this.carousel.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        });

        this.carousel.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe(touchStartX, touchEndX);
        });
      }

      handleSwipe(startX, endX) {
        const swipeThreshold = 50;
        const diff = startX - endX;

        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.prevSlide();
          }
        }
      }

      goToSlide(slideIndex) {
        this.currentSlide = slideIndex;
        this.updateCarousel();
        this.updateDots();
        
        if (this.autoScroll) {
          this.resetAutoScroll();
        }
      }

      nextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.totalProducts;
        this.updateCarousel();
        this.updateDots();
      }

      prevSlide() {
        this.currentSlide = this.currentSlide === 0 ? this.totalProducts - 1 : this.currentSlide - 1;
        this.updateCarousel();
        this.updateDots();
      }

      updateCarousel() {
        if (!this.carousel) return;
        
        const slideWidth = 100 / 3;
        const translateX = -(this.currentSlide * slideWidth);
        this.carousel.style.transform = `translateX(${translateX}%)`;
      }

      updateDots() {
        this.dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.currentSlide);
        });
      }

      startAutoScroll() {
        if (!this.autoScroll || this.totalProducts <= 3) return;
        
        this.autoScrollInterval = setInterval(() => {
          if (!this.isHovered) {
            this.nextSlide();
          }
        }, this.scrollSpeed);
      }

      pauseAutoScroll() {
        if (this.autoScrollInterval) {
          clearInterval(this.autoScrollInterval);
          this.autoScrollInterval = null;
        }
      }

      resetAutoScroll() {
        this.pauseAutoScroll();
        if (this.autoScroll && !this.isHovered) {
          this.startAutoScroll();
        }
      }

      disconnectedCallback() {
        this.pauseAutoScroll();
      }
    }

    customElements.define('recommended-products-{{ ai_gen_id }}', RecommendedProducts{{ ai_gen_id }});
  })();
</script>

