    </div>

    </div>

  </div>
</footer>

<script>
  (function () {
    const footer = document.querySelector('.gf');
    if (!footer) return;

    function syncHeight() {
      const h = footer.offsetHeight;
      document.documentElement.style.setProperty('--bcn-footer-h', h + 'px');
      document.documentElement.style.setProperty('--gf-h', h + 'px');
    }

    syncHeight();
    window.addEventListener('resize', syncHeight, { passive: true });

    // Watch for footer height changes (e.g., success message appears after submit)
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(syncHeight);
      ro.observe(footer);
    }
  })();
</script>
