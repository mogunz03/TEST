{% doc %}
  @prompt
    Create a pill-shaped header navigation block that can be added to the global header section and appears on every page. The pill header should have a floating, centered pill/capsule shape with a frosted glass or dark background, containing navigation links. It should match a premium minimalist streetwear aesthetic with clean typography, subtle blur effect, and smooth hover states. The block should be responsive and sit above or within the existing header.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pill-nav-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    z-index: 100;
    padding: {{ block.settings.vertical_spacing }}px 0;
  }

  .ai-pill-nav-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .ai-pill-nav-wrapper-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: {{ block.settings.link_spacing }}px;
    padding: {{ block.settings.pill_padding_vertical }}px {{ block.settings.pill_padding_horizontal }}px;
    background: {{ block.settings.background_color }};
    backdrop-filter: blur({{ block.settings.blur_strength }}px);
    -webkit-backdrop-filter: blur({{ block.settings.blur_strength }}px);
    border-radius: {{ block.settings.pill_border_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_color }};
  }

  .ai-pill-nav-link-{{ ai_gen_id }} {
    font-family: {{ block.settings.font_family }}, sans-serif;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    color: {{ block.settings.text_color }};
    text-decoration: none;
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    padding: {{ block.settings.link_padding_vertical }}px {{ block.settings.link_padding_horizontal }}px;
    border-radius: {{ block.settings.link_border_radius }}px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-pill-nav-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
    background: {{ block.settings.link_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-pill-nav-wrapper-{{ ai_gen_id }} {
      gap: {{ block.settings.link_spacing_mobile }}px;
      padding: {{ block.settings.pill_padding_vertical_mobile }}px {{ block.settings.pill_padding_horizontal_mobile }}px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .ai-pill-nav-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-pill-nav-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
      padding: {{ block.settings.link_padding_vertical_mobile }}px {{ block.settings.link_padding_horizontal_mobile }}px;
    }
  }
{% endstyle %}

<pill-nav-{{ ai_gen_id }} class="ai-pill-nav-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-pill-nav-container-{{ ai_gen_id }}">
    <nav class="ai-pill-nav-wrapper-{{ ai_gen_id }}" role="navigation" aria-label="Main navigation">
      {% if block.settings.link_1_text != blank %}
        <a href="{{ block.settings.link_1_url }}" class="ai-pill-nav-link-{{ ai_gen_id }}">
          {{ block.settings.link_1_text }}
        </a>
      {% endif %}
      {% if block.settings.link_2_text != blank %}
        <a href="{{ block.settings.link_2_url }}" class="ai-pill-nav-link-{{ ai_gen_id }}">
          {{ block.settings.link_2_text }}
        </a>
      {% endif %}
      {% if block.settings.link_3_text != blank %}
        <a href="{{ block.settings.link_3_url }}" class="ai-pill-nav-link-{{ ai_gen_id }}">
          {{ block.settings.link_3_text }}
        </a>
      {% endif %}
      {% if block.settings.link_4_text != blank %}
        <a href="{{ block.settings.link_4_url }}" class="ai-pill-nav-link-{{ ai_gen_id }}">
          {{ block.settings.link_4_text }}
        </a>
      {% endif %}
      {% if block.settings.link_5_text != blank %}
        <a href="{{ block.settings.link_5_url }}" class="ai-pill-nav-link-{{ ai_gen_id }}">
          {{ block.settings.link_5_text }}
        </a>
      {% endif %}
      {% if block.settings.link_6_text != blank %}
        <a href="{{ block.settings.link_6_url }}" class="ai-pill-nav-link-{{ ai_gen_id }}">
          {{ block.settings.link_6_text }}
        </a>
      {% endif %}
    </nav>
  </div>
</pill-nav-{{ ai_gen_id }}>

<script>
  (function() {
    class PillNav{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.highlightActiveLink();
      }

      highlightActiveLink() {
        const currentPath = window.location.pathname;
        const links = this.querySelectorAll('.ai-pill-nav-link-{{ ai_gen_id }}');
        
        links.forEach(link => {
          const linkPath = new URL(link.href).pathname;
          if (linkPath === currentPath) {
            link.style.color = '{{ block.settings.text_hover_color }}';
            link.style.background = '{{ block.settings.link_hover_background }}';
          }
        });
      }
    }

    customElements.define('pill-nav-{{ ai_gen_id }}', PillNav{{ ai_gen_id }});
  })();
</script>

