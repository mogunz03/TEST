{% doc %}
  @prompt
    create a  marquee carousel showing each product  only display each items once, prdouct card no shadow on hover, show product second imag eon hover, no product card background,select products not collection, product card no shadow, full width, , only product name align left ,no price no button,, ts selected still wont display
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-carousel-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .ai-marquee-track-{{ ai_gen_id }} {
    display: flex;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    gap: {{ block.settings.product_spacing }}px;
  }

  .ai-marquee-track-{{ ai_gen_id }}:hover {
    animation-play-state: {{ block.settings.pause_on_hover | default: true }};
  }

  .ai-product-card-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.product_width }}px;
    position: relative;
    cursor: pointer;
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .ai-product-image-secondary-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-image-secondary-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-image-{{ ai_gen_id }} {
    opacity: 0;
  }

  .ai-product-title-{{ ai_gen_id }} {
    margin-top: {{ block.settings.title_spacing }}px;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-align: left;
    line-height: 1.2;
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-weight: {{ settings.type_heading_font.weight }};
    text-transform: {{ block.settings.title_case }};
  }

  .ai-product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-100% - {{ block.settings.product_spacing }}px));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-card-{{ ai_gen_id }} {
      width: {{ block.settings.product_width | times: 0.8 }}px;
    }
    
    .ai-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<marquee-carousel-{{ ai_gen_id }}
  class="ai-marquee-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-marquee-track-{{ ai_gen_id }}">
    {% if block.settings.selected_products.size > 0 %}
      {% for product in block.settings.selected_products %}
        <div class="ai-product-card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
          <a href="{{ product.url }}" class="ai-product-link-{{ ai_gen_id }}">
            <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}"
                >
                {% if product.images[1] %}
                  <img
                    src="{{ product.images[1] | image_url: width: 600 }}"
                    alt="{{ product.images[1].alt | escape }}"
                    class="ai-product-image-secondary-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ 600 | divided_by: product.images[1].aspect_ratio | round }}"
                  >
                {% endif %}
              {% else %}
                <div class="ai-product-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            
            <h3 class="ai-product-title-{{ ai_gen_id }}">
              {{ product.title }}
            </h3>
          </a>
        </div>
      {% endfor %}
      
      {% comment %}Duplicate products for seamless loop{% endcomment %}
      {% for product in block.settings.selected_products %}
        <div class="ai-product-card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
          <a href="{{ product.url }}" class="ai-product-link-{{ ai_gen_id }}">
            <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}"
                >
                {% if product.images[1] %}
                  <img
                    src="{{ product.images[1] | image_url: width: 600 }}"
                    alt="{{ product.images[1].alt | escape }}"
                    class="ai-product-image-secondary-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ 600 | divided_by: product.images[1].aspect_ratio | round }}"
                  >
                {% endif %}
              {% else %}
                <div class="ai-product-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            
            <h3 class="ai-product-title-{{ ai_gen_id }}">
              {{ product.title }}
            </h3>
          </a>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..6) %}
        <div class="ai-product-card-{{ ai_gen_id }}">
          <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
            <div class="ai-product-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          </div>
          <h3 class="ai-product-title-{{ ai_gen_id }}">
            Sample Product {{ i }}
          </h3>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</marquee-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class MarqueeCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('.ai-marquee-track-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupMarquee();
      }

      setupMarquee() {
        if (!this.track) return;

        const pauseOnHover = {{ block.settings.pause_on_hover | json }};
        
        if (pauseOnHover) {
          this.track.addEventListener('mouseenter', () => {
            this.track.style.animationPlayState = 'paused';
          });

          this.track.addEventListener('mouseleave', () => {
            this.track.style.animationPlayState = 'running';
          });
        }
      }
    }

    customElements.define('marquee-carousel-{{ ai_gen_id }}', MarqueeCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product marquee carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product_list",
      "id": "selected_products",
      "label": "Select products",
      "limit": 20
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "product_width",
      "min": 150,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Product width",
      "default": 250
    },
    {
      "type": "range",
      "id": "product_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Product spacing",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "3/4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16/9",
          "label": "Wide (16:9)"
        }
      ],
      "default": "3/4"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Product title"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 5,
      "max": 25,
      "step": 1,
      "unit": "px",
      "label": "Title spacing",
      "default": 12
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "title_case",
      "label": "Title case",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "Product marquee carousel"
    }
  ]
}
{% endschema %}