{% doc %}
  @prompt
    "Design a high-fashion, highly editorial homepage for my Shopify store. Model the look after https://www.google.com/search?q=terminal27.com.
    
    The page must use a minimalist, high-contrast palette (black, white, and grayscale) and sophisticated typography (a mix of bold sans-serif and classic serif).
    
    Use a modular, stacked-block layout that feels like a digital magazine, prioritizing large, impactful visuals.
    
    The structure should balance commerce with content, featuring:
    
    A prominent, fixed header with main navigation.
    
    A large, full-width hero section for a campaign or live event.
    
    Numbered or clearly separated sections for editorial features/interviews (brand storytelling) interspersed with curated new product arrivals.
    
    A concluding section dedicated to the brand's creative mission/studio ethos.", "Design a high-fashion, highly editorial homepage for my Shopify store, modeled after https://www.google.com/search?q=terminal27.com.
    
    The core aesthetic must be minimalist, high-contrast, and dynamic. Use a distinctive blended page style where text and images interact seamlessly (like a digital art journal).
    
    The layout should be a modular, stacked-block format with sophisticated typography and large, impactful visuals.
    
    Crucially, implement subtle, custom hover animations on all interactive elements (links, images, CTAs) to enhance the feeling of a dynamic, high-end experience.
    
    The page structure must balance content and commerce, including: a fixed header, a full-width hero section, dedicated editorial features, and curated product arrivals."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-homepage-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    line-height: 1.4;
    overflow-x: hidden;
    position: relative;
  }

  .ai-editorial-fixed-header-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background-color: {{ block.settings.header_bg_color }};
    backdrop-filter: blur(10px);
    border-bottom: 1px solid {{ block.settings.header_border_color }};
    padding: 15px 30px;
    transition: all 0.3s ease;
  }

  .ai-editorial-header-content-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-editorial-logo-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: 24px;
    color: {{ block.settings.header_text_color }};
    text-decoration: none;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }

  .ai-editorial-logo-{{ ai_gen_id }}:hover {
    opacity: 0.7;
    transform: translateY(-1px);
  }

  .ai-editorial-nav-{{ ai_gen_id }} {
    display: flex;
    gap: 40px;
  }

  .ai-editorial-nav-link-{{ ai_gen_id }} {
    color: {{ block.settings.header_text_color }};
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    position: relative;
    transition: all 0.3s ease;
  }

  .ai-editorial-nav-link-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: {{ block.settings.accent_color }};
    transition: width 0.3s ease;
  }

  .ai-editorial-nav-link-{{ ai_gen_id }}:hover::after {
    width: 100%;
  }

  .ai-editorial-nav-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.accent_color }};
    transform: translateY(-1px);
  }

  .ai-editorial-hero-{{ ai_gen_id }} {
    position: relative;
    height: {{ block.settings.hero_height }}vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.hero_bg_color }};
    overflow: hidden;
    margin-top: 70px;
  }

  .ai-editorial-hero-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.8s ease;
  }

  .ai-editorial-hero-{{ ai_gen_id }}:hover .ai-editorial-hero-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-editorial-hero-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.hero_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .ai-editorial-hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
    opacity: 0.3;
  }

  .ai-editorial-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient({{ block.settings.overlay_direction }}, 
      {{ block.settings.overlay_color_start }} {{ block.settings.overlay_start }}%, 
      {{ block.settings.overlay_color_end }} {{ block.settings.overlay_end }}%);
    z-index: 2;
    transition: opacity 0.5s ease;
  }

  .ai-editorial-hero-{{ ai_gen_id }}:hover .ai-editorial-hero-overlay-{{ ai_gen_id }} {
    opacity: 0.8;
  }

  .ai-editorial-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 900px;
    padding: 0 20px;
    transform: translateY(20px);
    opacity: 0;
    animation: ai-editorial-fade-in-up-{{ ai_gen_id }} 1s ease 0.5s forwards;
  }

  @keyframes ai-editorial-fade-in-up-{{ ai_gen_id }} {
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .ai-editorial-hero-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.hero_title_size }}px;
    line-height: 0.9;
    letter-spacing: {{ block.settings.hero_letter_spacing }}px;
    color: {{ block.settings.hero_text_color }};
    margin: 0 0 20px;
    text-transform: {{ block.settings.hero_text_transform }};
    transition: all 0.3s ease;
  }

  .ai-editorial-hero-title-{{ ai_gen_id }}:hover {
    letter-spacing: {{ block.settings.hero_letter_spacing | plus: 1 }}px;
  }

  .ai-editorial-hero-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_subtitle_size }}px;
    color: {{ block.settings.hero_text_color }};
    margin: 0 0 40px;
    opacity: 0.9;
    font-weight: 300;
    transition: all 0.3s ease;
  }

  .ai-editorial-hero-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 18px 45px;
    background-color: {{ block.settings.cta_bg_color }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 2px solid {{ block.settings.cta_border_color }};
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  .ai-editorial-hero-cta-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.cta_hover_bg }};
    transition: left 0.4s ease;
    z-index: -1;
  }

  .ai-editorial-hero-cta-{{ ai_gen_id }}:hover::before {
    left: 0;
  }

  .ai-editorial-hero-cta-{{ ai_gen_id }}:hover {
    color: {{ block.settings.cta_hover_text }};
    border-color: {{ block.settings.cta_hover_border }};
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
  }

  .ai-editorial-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
  }

  .ai-editorial-section-header-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 30px;
    margin-bottom: 60px;
    position: relative;
  }

  .ai-editorial-section-number-{{ ai_gen_id }} {
    font-family: {{ block.settings.accent_font.family }}, {{ block.settings.accent_font.fallback_families }};
    font-weight: {{ block.settings.accent_font.weight }};
    font-size: {{ block.settings.section_number_size }}px;
    color: {{ block.settings.accent_color }};
    letter-spacing: 3px;
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  .ai-editorial-section-header-{{ ai_gen_id }}:hover .ai-editorial-section-number-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateX(5px);
  }

  .ai-editorial-section-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.section_title_size }}px;
    line-height: 1.1;
    color: {{ block.settings.text_color }};
    margin: 0;
    text-transform: {{ block.settings.section_text_transform }};
    letter-spacing: {{ block.settings.section_letter_spacing }}px;
    position: relative;
    transition: all 0.3s ease;
  }

  .ai-editorial-section-title-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: {{ block.settings.accent_color }};
    transition: width 0.5s ease;
  }

  .ai-editorial-section-header-{{ ai_gen_id }}:hover .ai-editorial-section-title-{{ ai_gen_id }}::after {
    width: 60px;
  }

  .ai-editorial-blended-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.section_spacing }}px;
  }

  .ai-editorial-feature-large-{{ ai_gen_id }} {
    grid-column: span 8;
    position: relative;
    overflow: hidden;
    background-color: {{ block.settings.card_bg_color }};
    transition: all 0.5s ease;
  }

  .ai-editorial-feature-small-{{ ai_gen_id }} {
    grid-column: span 4;
    position: relative;
    overflow: hidden;
    background-color: {{ block.settings.card_bg_color }};
    transition: all 0.5s ease;
  }

  .ai-editorial-feature-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .ai-editorial-feature-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.feature_image_height }}px;
    object-fit: cover;
    display: block;
    transition: all 0.6s ease;
  }

  .ai-editorial-feature-{{ ai_gen_id }}:hover .ai-editorial-feature-image-{{ ai_gen_id }} {
    transform: scale(1.08);
    filter: brightness(1.1) contrast(1.1);
  }

  .ai-editorial-feature-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.feature_image_height }}px;
    background-color: {{ block.settings.placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-editorial-feature-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  .ai-editorial-feature-{{ ai_gen_id }}:hover .ai-editorial-feature-placeholder-{{ ai_gen_id }} svg {
    opacity: 0.5;
  }

  .ai-editorial-feature-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    position: relative;
    background: linear-gradient(135deg, {{ block.settings.card_bg_color }} 0%, {{ block.settings.card_bg_color }}f0 100%);
  }

  .ai-editorial-feature-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, {{ block.settings.card_bg_color }}e6);
    padding: {{ block.settings.card_padding }}px;
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.4s ease;
  }

  .ai-editorial-feature-{{ ai_gen_id }}:hover .ai-editorial-feature-overlay-{{ ai_gen_id }} {
    transform: translateY(0);
    opacity: 1;
  }

  .ai-editorial-feature-category-{{ ai_gen_id }} {
    font-size: 11px;
    color: {{ block.settings.accent_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .ai-editorial-feature-{{ ai_gen_id }}:hover .ai-editorial-feature-category-{{ ai_gen_id }} {
    letter-spacing: 3px;
  }

  .ai-editorial-feature-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.feature_title_size }}px;
    line-height: 1.2;
    color: {{ block.settings.text_color }};
    margin: 0 0 15px;
    transition: all 0.3s ease;
  }

  .ai-editorial-feature-{{ ai_gen_id }}:hover .ai-editorial-feature-title-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
  }

  .ai-editorial-feature-excerpt-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin-bottom: 25px;
    transition: all 0.3s ease;
  }

  .ai-editorial-feature-link-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
    text-decoration: none;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 12px;
    position: relative;
    transition: all 0.3s ease;
  }

  .ai-editorial-feature-link-{{ ai_gen_id }}::after {
    content: '→';
    margin-left: 8px;
    transition: all 0.3s ease;
  }

  .ai-editorial-feature-link-{{ ai_gen_id }}:hover::after {
    margin-left: 15px;
  }

  .ai-editorial-feature-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: {{ block.settings.product_grid_gap }}px;
    margin-bottom: {{ block.settings.section_spacing }}px;
  }

  .ai-editorial-product-card-{{ ai_gen_id }} {
    text-align: center;
    background-color: {{ block.settings.card_bg_color }};
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
    cursor: pointer;
  }

  .ai-editorial-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
  }

  .ai-editorial-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .ai-editorial-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.product_image_height }}px;
    object-fit: cover;
    display: block;
    transition: all 0.5s ease;
  }

  .ai-editorial-product-card-{{ ai_gen_id }}:hover .ai-editorial-product-image-{{ ai_gen_id }} {
    transform: scale(1.1);
    filter: brightness(1.05);
  }

  .ai-editorial-product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.product_image_height }}px;
    background-color: {{ block.settings.placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    transition: all 0.3s ease;
  }

  .ai-editorial-product-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 150px;
    max-height: 150px;
    opacity: 0.3;
    transition: all 0.3s ease;
  }

  .ai-editorial-product-card-{{ ai_gen_id }}:hover .ai-editorial-product-placeholder-{{ ai_gen_id }} svg {
    opacity: 0.6;
    transform: scale(1.1);
  }

  .ai-editorial-product-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, {{ block.settings.accent_color }}20 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-editorial-product-card-{{ ai_gen_id }}:hover .ai-editorial-product-overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-editorial-product-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
    margin: 0 0 10px;
    text-transform: {{ block.settings.product_text_transform }};
    transition: all 0.3s ease;
    padding: 0 15px;
  }

  .ai-editorial-product-card-{{ ai_gen_id }}:hover .ai-editorial-product-title-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
    letter-spacing: 1px;
  }

  .ai-editorial-product-price-{{ ai_gen_id }} {
    font-size: 15px;
    color: {{ block.settings.accent_color }};
    font-weight: 600;
    transition: all 0.3s ease;
    padding: 0 15px;
  }

  .ai-editorial-product-card-{{ ai_gen_id }}:hover .ai-editorial-product-price-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-editorial-text-blend-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    right: -100px;
    transform: translateY(-50%) rotate(90deg);
    font-family: {{ block.settings.accent_font.family }}, {{ block.settings.accent_font.fallback_families }};
    font-weight: {{ block.settings.accent_font.weight }};
    font-size: 120px;
    color: {{ block.settings.accent_color }};
    opacity: 0.05;
    pointer-events: none;
    transition: all 0.5s ease;
  }

  .ai-editorial-section-{{ ai_gen_id }}:hover .ai-editorial-text-blend-{{ ai_gen_id }} {
    opacity: 0.1;
    right: -80px;
  }

  @media screen and (max-width: 768px) {
    .ai-editorial-fixed-header-{{ ai_gen_id }} {
      padding: 10px 20px;
    }
    
    .ai-editorial-nav-{{ ai_gen_id }} {
      gap: 20px;
    }
    
    .ai-editorial-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.hero_title_size | times: 0.6 }}px;
    }
    
    .ai-editorial-section-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_title_size | times: 0.7 }}px;
    }
    
    .ai-editorial-blended-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
    
    .ai-editorial-feature-large-{{ ai_gen_id }},
    .ai-editorial-feature-small-{{ ai_gen_id }} {
      grid-column: span 1;
    }
    
    .ai-editorial-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .ai-editorial-text-blend-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-editorial-products-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-editorial-homepage-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_fixed_header %}
    <header class="ai-editorial-fixed-header-{{ ai_gen_id }}">
      <div class="ai-editorial-header-content-{{ ai_gen_id }}">
        <a href="/" class="ai-editorial-logo-{{ ai_gen_id }}">
          {{ block.settings.header_logo_text | default: "DAUZE" }}
        </a>
        <nav class="ai-editorial-nav-{{ ai_gen_id }}">
          {% if block.settings.nav_link_1_text != blank %}
            <a href="{{ block.settings.nav_link_1_url }}" class="ai-editorial-nav-link-{{ ai_gen_id }}">
              {{ block.settings.nav_link_1_text }}
            </a>
          {% endif %}
          {% if block.settings.nav_link_2_text != blank %}
            <a href="{{ block.settings.nav_link_2_url }}" class="ai-editorial-nav-link-{{ ai_gen_id }}">
              {{ block.settings.nav_link_2_text }}
            </a>
          {% endif %}
          {% if block.settings.nav_link_3_text != blank %}
            <a href="{{ block.settings.nav_link_3_url }}" class="ai-editorial-nav-link-{{ ai_gen_id }}">
              {{ block.settings.nav_link_3_text }}
            </a>
          {% endif %}
          {% if block.settings.nav_link_4_text != blank %}
            <a href="{{ block.settings.nav_link_4_url }}" class="ai-editorial-nav-link-{{ ai_gen_id }}">
              {{ block.settings.nav_link_4_text }}
            </a>
          {% endif %}
        </nav>
      </div>
    </header>
  {% endif %}

  <section class="ai-editorial-hero-{{ ai_gen_id }}">
    {% if block.settings.hero_image %}
      <img
        src="{{ block.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ block.settings.hero_image.alt | escape }}"
        class="ai-editorial-hero-image-{{ ai_gen_id }}"
        loading="lazy"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
      >
    {% else %}
      <div class="ai-editorial-hero-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
    
    {% if block.settings.show_overlay %}
      <div class="ai-editorial-hero-overlay-{{ ai_gen_id }}"></div>
    {% endif %}
    
    <div class="ai-editorial-hero-content-{{ ai_gen_id }}">
      {% if block.settings.hero_title != blank %}
        <h1 class="ai-editorial-hero-title-{{ ai_gen_id }}">{{ block.settings.hero_title }}</h1>
      {% endif %}
      
      {% if block.settings.hero_subtitle != blank %}
        <p class="ai-editorial-hero-subtitle-{{ ai_gen_id }}">{{ block.settings.hero_subtitle }}</p>
      {% endif %}
      
      {% if block.settings.hero_cta_text != blank and block.settings.hero_cta_link != blank %}
        <a href="{{ block.settings.hero_cta_link }}" class="ai-editorial-hero-cta-{{ ai_gen_id }}">
          {{ block.settings.hero_cta_text }}
        </a>
      {% endif %}
    </div>
  </section>

  {% if block.settings.show_editorial_section %}
    <section class="ai-editorial-section-{{ ai_gen_id }}">
      <div class="ai-editorial-text-blend-{{ ai_gen_id }}">EDITORIAL</div>
      
      <div class="ai-editorial-section-header-{{ ai_gen_id }}">
        {% if block.settings.editorial_section_number != blank %}
          <div class="ai-editorial-section-number-{{ ai_gen_id }}">{{ block.settings.editorial_section_number }}</div>
        {% endif %}
        
        {% if block.settings.editorial_title != blank %}
          <h2 class="ai-editorial-section-title-{{ ai_gen_id }}">{{ block.settings.editorial_title }}</h2>
        {% endif %}
      </div>
      
      <div class="ai-editorial-blended-grid-{{ ai_gen_id }}">
        {% liquid
          assign feature_1_image = block.settings.feature_1_image
          assign feature_1_category = block.settings.feature_1_category
          assign feature_1_title = block.settings.feature_1_title
          assign feature_1_excerpt = block.settings.feature_1_excerpt
          assign feature_1_link = block.settings.feature_1_link
          assign feature_1_link_text = block.settings.feature_1_link_text
        %}
        
        {% if feature_1_title != blank or feature_1_image %}
          <article class="ai-editorial-feature-{{ ai_gen_id }} ai-editorial-feature-large-{{ ai_gen_id }}">
            {% if feature_1_image %}
              <img
                src="{{ feature_1_image | image_url: width: 800 }}"
                alt="{{ feature_1_image.alt | escape }}"
                class="ai-editorial-feature-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ feature_1_image.width }}"
                height="{{ feature_1_image.height }}"
              >
            {% else %}
              <div class="ai-editorial-feature-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
            
            <div class="ai-editorial-feature-content-{{ ai_gen_id }}">
              {% if feature_1_category != blank %}
                <div class="ai-editorial-feature-category-{{ ai_gen_id }}">{{ feature_1_category }}</div>
              {% endif %}
              
              {% if feature_1_title != blank %}
                <h3 class="ai-editorial-feature-title-{{ ai_gen_id }}">{{ feature_1_title }}</h3>
              {% endif %}
              
              {% if feature_1_excerpt != blank %}
                <div class="ai-editorial-feature-excerpt-{{ ai_gen_id }}">{{ feature_1_excerpt }}</div>
              {% endif %}
              
              {% if feature_1_link != blank and feature_1_link_text != blank %}
                <a href="{{ feature_1_link }}" class="ai-editorial-feature-link-{{ ai_gen_id }}">
                  {{ feature_1_link_text }}
                </a>
              {% endif %}
            </div>
            
            <div class="ai-editorial-feature-overlay-{{ ai_gen_id }}">
              {% if feature_1_category != blank %}
                <div class="ai-editorial-feature-category-{{ ai_gen_id }}">{{ feature_1_category }}</div>
              {% endif %}
              {% if feature_1_title != blank %}
                <h3 class="ai-editorial-feature-title-{{ ai_gen_id }}">{{ feature_1_title }}</h3>
              {% endif %}
            </div>
          </article>
        {% endif %}

        <div class="ai-editorial-feature-small-{{ ai_gen_id }}">
          {% for i in (2..3) %}
            {% liquid
              assign feature_image_key = 'feature_' | append: i | append: '_image'
              assign feature_category_key = 'feature_' | append: i | append: '_category'
              assign feature_title_key = 'feature_' | append: i | append: '_title'
              assign feature_excerpt_key = 'feature_' | append: i | append: '_excerpt'
              assign feature_link_key = 'feature_' | append: i | append: '_link'
              assign feature_link_text_key = 'feature_' | append: i | append: '_link_text'
              
              assign feature_image = block.settings[feature_image_key]
              assign feature_category = block.settings[feature_category_key]
              assign feature_title = block.settings[feature_title_key]
              assign feature_excerpt = block.settings[feature_excerpt_key]
              assign feature_link = block.settings[feature_link_key]
              assign feature_link_text = block.settings[feature_link_text_key]
            %}
            
            {% if feature_title != blank or feature_image %}
              <article class="ai-editorial-feature-{{ ai_gen_id }}" style="margin-bottom: 30px;">
                {% if feature_image %}
                  <img
                    src="{{ feature_image | image_url: width: 400 }}"
                    alt="{{ feature_image.alt | escape }}"
                    class="ai-editorial-feature-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ feature_image.width }}"
                    height="{{ feature_image.height }}"
                    style="height: 200px;"
                  >
                {% else %}
                  <div class="ai-editorial-feature-placeholder-{{ ai_gen_id }}" style="height: 200px;">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                
                <div class="ai-editorial-feature-content-{{ ai_gen_id }}">
                  {% if feature_category != blank %}
                    <div class="ai-editorial-feature-category-{{ ai_gen_id }}">{{ feature_category }}</div>
                  {% endif %}
                  
                  {% if feature_title != blank %}
                    <h3 class="ai-editorial-feature-title-{{ ai_gen_id }}" style="font-size: 18px;">{{ feature_title }}</h3>
                  {% endif %}
                  
                  {% if feature_link != blank and feature_link_text != blank %}
                    <a href="{{ feature_link }}" class="ai-editorial-feature-link-{{ ai_gen_id }}">
                      {{ feature_link_text }}
                    </a>
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if block.settings.show_products_section %}
    <section class="ai-editorial-section-{{ ai_gen_id }}">
      <div class="ai-editorial-text-blend-{{ ai_gen_id }}">ARRIVALS</div>
      
      <div class="ai-editorial-section-header-{{ ai_gen_id }}">
        {% if block.settings.products_section_number != blank %}
          <div class="ai-editorial-section-number-{{ ai_gen_id }}">{{ block.settings.products_section_number }}</div>
        {% endif %}
        
        {% if block.settings.products_title != blank %}
          <h2 class="ai-editorial-section-title-{{ ai_gen_id }}">{{ block.settings.products_title }}</h2>
        {% endif %}
      </div>
      
      <div class="ai-editorial-products-grid-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign product_key = 'featured_product_' | append: i
            assign product = block.settings[product_key]
          %}
          
          <div class="ai-editorial-product-card-{{ ai_gen_id }}">
            <div class="ai-editorial-product-image-wrapper-{{ ai_gen_id }}">
              {% if product != blank %}
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-editorial-product-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                  >
                {% else %}
                  <div class="ai-editorial-product-placeholder-{{ ai_gen_id }}">
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                <div class="ai-editorial-product-overlay-{{ ai_gen_id }}"></div>
              {% else %}
                <div class="ai-editorial-product-placeholder-{{ ai_gen_id }}">
                  {{ 'product-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            
            {% if product != blank %}
              <h4 class="ai-editorial-product-title-{{ ai_gen_id }}">{{ product.title }}</h4>
              <div class="ai-editorial-product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
            {% else %}
              <h4 class="ai-editorial-product-title-{{ ai_gen_id }}">Select a product</h4>
              <div class="ai-editorial-product-price-{{ ai_gen_id }}">€0.00</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</div>

