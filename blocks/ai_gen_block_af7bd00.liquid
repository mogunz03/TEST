{% doc %}
  @prompt
    Implement a continuous scrolling marquee carousel for product recommendations in a Shopify Dawn theme by replacing the {% for product in products ... %} loop in sections/product-recommendations.liquid with {% for product in products limit: section.settings.max_products %}{% capture product_card_html %}<div class="resource-list__item">{% render 'product-card', product: product, section_id: section.id %}</div>{% endcapture %}{% liquid assign slides = slides | append: product_card_html | append: '' assign list_items = list_items | append: product_card_html %}{% endfor %}, adding CSS to the {% stylesheet %} block with @keyframes scroll-left { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }, .resource-list.resource-list__carousel { overflow: hidden; width: 100%; display: block; }, .resource-list__carousel :is(.carousel__slide-list, .slider__slide-list) { display: flex; white-space: nowrap; animation: scroll-left 60s linear infinite; width: 200%; will-change: transform; padding: 0 !important; margin: 0 !important; }, .resource-list__carousel:hover :is(.carousel__slide-list, .slider__slide-list) { animation-play-state: paused; }, and .resource-list__slide { flex-shrink: 0; }, and deleting the "static-product-card" block from the {% schema %} presets.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-carousel-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__header {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    padding: 0 20px;
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__title {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0;
    text-transform: {% if block.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    line-height: var(--font-heading-line-height);
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__subtitle {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 8px 0 0;
    font-family: var(--font-body-family);
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__track {
    display: flex;
    width: 200%;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-marquee-carousel-{{ ai_gen_id }}:hover .ai-marquee-carousel-{{ ai_gen_id }}__track {
    animation-play-state: {% if block.settings.pause_on_hover %}paused{% else %}running{% endif %};
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__slide {
    flex-shrink: 0;
    width: {{ block.settings.card_width }}px;
    margin-right: {{ block.settings.card_spacing }}px;
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__product-card {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__product-card:hover {
    transform: {% if block.settings.card_hover_effect == 'lift' %}translateY(-4px){% elsif block.settings.card_hover_effect == 'scale' %}scale(1.02){% else %}none{% endif %};
    box-shadow: {% if block.settings.card_hover_effect != 'none' %}0 8px 25px rgba(0, 0, 0, 0.1){% else %}none{% endif %};
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__product-image {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__product-card:hover .ai-marquee-carousel-{{ ai_gen_id }}__product-image img {
    transform: {% if block.settings.image_hover_effect == 'zoom' %}scale(1.05){% else %}none{% endif %};
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__product-info {
    padding: {{ block.settings.card_padding }}px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__product-title {
    color: {{ block.settings.product_title_color }};
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.3;
    text-transform: {% if block.settings.product_title_uppercase %}uppercase{% else %}none{% endif %};
    font-family: var(--font-heading-family);
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__product-price {
    color: {{ block.settings.product_price_color }};
    font-size: {{ block.settings.product_price_size }}px;
    font-weight: 600;
    margin: 0;
    font-family: var(--font-body-family);
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__product-price--compare {
    text-decoration: line-through;
    opacity: 0.7;
    margin-right: 8px;
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 4px 8px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    z-index: 2;
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__empty-state {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
  }

  .ai-marquee-carousel-{{ ai_gen_id }}__empty-state h3 {
    margin: 0 0 8px;
    font-size: 18px;
    color: {{ block.settings.heading_color }};
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-carousel-{{ ai_gen_id }}__slide {
      width: {{ block.settings.card_width | times: 0.8 }}px;
    }
    
    .ai-marquee-carousel-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-marquee-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.subtitle != blank %}
    <div class="ai-marquee-carousel-{{ ai_gen_id }}__header">
      {% if block.settings.heading != blank %}
        <h2 class="ai-marquee-carousel-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-marquee-carousel-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.product_list != blank %}
    <div class="ai-marquee-carousel-{{ ai_gen_id }}__track">
      {% liquid
        assign slides_html = ''
        for product in block.settings.product_list limit: block.settings.max_products
          capture product_card_html
            echo '<div class="ai-marquee-carousel-' | append: ai_gen_id | append: '__slide">'
            echo '<a href="' | append: product.url | append: '" class="ai-marquee-carousel-' | append: ai_gen_id | append: '__product-card">'
            echo '<div class="ai-marquee-carousel-' | append: ai_gen_id | append: '__product-image">'
            
            if product.featured_image
              echo '<img src="' | append: product.featured_image | append: '" alt="' | append: product.featured_image.alt | escape | append: '" loading="lazy" width="' | append: product.featured_image.width | append: '" height="' | append: product.featured_image.height | append: '">'
            else
              echo '<div style="background: #f4f4f4; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">'
              echo 'product-1' | placeholder_svg_tag
              echo '</div>'
            endif
            
            if product.compare_at_price > product.price
              echo '<div class="ai-marquee-carousel-' | append: ai_gen_id | append: '__badge">Sale</div>'
            elsif product.available == false
              echo '<div class="ai-marquee-carousel-' | append: ai_gen_id | append: '__badge">Sold out</div>'
            endif
            
            echo '</div>'
            echo '<div class="ai-marquee-carousel-' | append: ai_gen_id | append: '__product-info">'
            echo '<h3 class="ai-marquee-carousel-' | append: ai_gen_id | append: '__product-title">' | append: product.title | append: '</h3>'
            echo '<div class="ai-marquee-carousel-' | append: ai_gen_id | append: '__product-price">'
            
            if product.compare_at_price > product.price
              echo '<span class="ai-marquee-carousel-' | append: ai_gen_id | append: '__product-price--compare">' | append: product.compare_at_price | money | append: '</span>'
            endif
            
            echo product.price | money
            echo '</div>'
            echo '</div>'
            echo '</a>'
            echo '</div>'
          endcapture
          
          assign slides_html = slides_html | append: product_card_html
        endfor
        
        echo slides_html
        echo slides_html
      %}
    </div>
  {% else %}
    <div class="ai-marquee-carousel-{{ ai_gen_id }}__empty-state">
      <h3>No products selected</h3>
      <p>Add products to display in the marquee carousel</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
