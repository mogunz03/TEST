{% comment %}
  Becane Collection — Margiela-style grid + Refine drawer
  File: sections/collection-becane.liquid

  - Auto-pulls Shopify native filters (collection.filters) from Search & Discovery
  - Left-drawer Refine panel with SORT BY + per-filter accordions
  - URL-driven; works without JS
  - Becane styling: italic uppercase title, mono caps tags, +/× accordions
{% endcomment %}

{% liquid
  if section.settings.font_preset == 'custom'
    assign heading_font = section.settings.heading_font.family | append: ', ' | append: section.settings.heading_font.fallback_families
    assign body_font = section.settings.body_font.family | append: ', ' | append: section.settings.body_font.fallback_families
  else
    assign heading_font = settings.type_heading_font.family | append: ', ' | append: settings.type_heading_font.fallback_families
    assign body_font = settings.type_body_font.family | append: ', ' | append: settings.type_body_font.fallback_families
  endif

  assign sort_options = collection.sort_options
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign filters = collection.filters
  assign total = collection.products_count | default: collection.all_products_count

  assign pad = total | append: ''
  assign pad_len = pad.size

  comment
    Optional banner under the logo: a full-width video and a centred intro text.
    The video comes from the collection itself (collection metafield custom.banner_video, a
    video file), so each collection can have its own or none. Optional section-level defaults
    exist for the editor. Each part has its own on/off switch in the section settings.
  endcomment
  assign cv = collection.metafields.custom.banner_video.value
  assign show_video = false
  if section.settings.show_banner_video
    if cv != blank or section.settings.banner_video != blank or section.settings.banner_video_url != blank
      assign show_video = true
    endif
  endif

  assign intro_html = collection.description
  if intro_html == blank
    assign intro_html = section.settings.intro_fallback
  endif
  assign show_intro = false
  if section.settings.show_intro and intro_html != blank
    assign show_intro = true
  endif
%}

{%- if section.settings.font_preset == 'custom' -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}
{%- endif -%}

{% style %}
  #bcoll-{{ section.id }} {
    --bc-bg: {{ section.settings.bg_color | default: 'var(--color-background)' }};
    --bc-fg: {{ section.settings.text_color }};
    --bc-muted: {{ section.settings.muted_color }};
    --bc-hairline: {{ section.settings.hairline_color }};
    --bc-accent: {{ section.settings.accent_color }};
    --bc-btn-bg: {{ section.settings.btn_bg }};
    --bc-btn-fg: {{ section.settings.btn_fg }};
    --bc-font-h: {{ heading_font }};
    --bc-font-b: {{ body_font }};
    --bc-font-mono: var(--font-body--family);
    --bc-pad-x: {{ section.settings.padding_x }}px;

    background: var(--bc-bg);
    color: var(--bc-fg);
    font-family: var(--bc-font-b);
    min-height: 100vh;
    min-height: 100dvh;
    padding: 80px {{ section.settings.padding_x }}px 120px;
    box-sizing: border-box;
  }

  #bcoll-{{ section.id }} *,
  #bcoll-{{ section.id }} *::before,
  #bcoll-{{ section.id }} *::after { box-sizing: border-box; }

  /* HEADER */
  .bcoll__header-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 24px;
    max-width: 1800px;
    margin: 0 auto 48px;
    position: relative;
  }

  .bcoll__refine-{{ section.id }} {
    justify-self: start;
    background: transparent;
    border: 1px solid var(--bc-fg);
    color: var(--bc-fg);
    padding: 6px 14px;
    font-family: var(--bc-font-h);
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .bcoll__refine-{{ section.id }}:hover { background: var(--bc-fg); color: var(--bc-bg); }

  .bcoll__title-wrap-{{ section.id }} {
    text-align: center;
    grid-column: 2;
  }

  .bcoll__breadcrumb-{{ section.id }} {
    font-family: var(--bc-font-h);
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--bc-muted);
    margin: 0 0 12px;
  }
  .bcoll__breadcrumb-{{ section.id }} a { color: inherit; text-decoration: none; }
  .bcoll__breadcrumb-{{ section.id }} a:hover { color: var(--bc-fg); }
  .bcoll__breadcrumb-{{ section.id }} .sep { margin: 0 8px; opacity: 0.5; }

  .bcoll__title-{{ section.id }} {
    font-family: var(--bc-font-h);
    font-size: var(--dz-fs-heading, clamp(15px, 1.3vw, 18px));
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: uppercase;
    margin: 0;
  }

  .bcoll__count-{{ section.id }} {
    justify-self: end;
    align-self: start;
    font-family: var(--bc-font-mono);
    font-size: 10px;
    color: var(--bc-fg);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-top: 8px;
    white-space: nowrap;
  }

  /* PRODUCT GRID */
  .bcoll__grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.row_gap }}px {{ section.settings.col_gap }}px;
    max-width: 1800px;
    margin: 0 auto;
  }

  .bcoll__card-{{ section.id }} {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .bcoll__card-img-{{ section.id }} {
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect }};
    overflow: hidden;
    background: #ececec;
    position: relative;
  }
  .bcoll__card-img-{{ section.id }} img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.4s ease;
  }
  .bcoll__card-img-{{ section.id }} img.is-hover {
    position: absolute; inset: 0;
    opacity: 0;
  }
  .bcoll__card-{{ section.id }}:hover .bcoll__card-img-{{ section.id }} img.is-primary { opacity: 0; }
  .bcoll__card-{{ section.id }}:hover .bcoll__card-img-{{ section.id }} img.is-hover { opacity: 1; }

  .bcoll__card-info-{{ section.id }} {
    padding: 10px 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .bcoll__card-title-{{ section.id }} {
    font-family: var(--bc-font-h);
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    margin: 0;
    display: flex; align-items: center; gap: 6px;
  }
  .bcoll__card-price-{{ section.id }} {
    font-family: var(--bc-font-mono);
    font-size: 10px;
    color: var(--bc-muted);
    letter-spacing: 0.04em;
  }
  .bcoll__card-price-{{ section.id }}.is-sale { color: var(--bc-accent); }
  .bcoll__card-compare-{{ section.id }} {
    text-decoration: line-through;
    color: var(--bc-muted);
    opacity: 0.6;
    margin-left: 6px;
  }
  .bcoll__wishlist-{{ section.id }} {
    background: none; border: none; padding: 0;
    cursor: pointer; color: inherit;
    display: inline-flex; align-items: center;
  }
  .bcoll__wishlist-{{ section.id }} svg {
    width: 12px; height: 12px;
    stroke: currentColor; fill: none;
    stroke-width: 1.5;
  }

  /* EMPTY STATE */
  .bcoll__empty-{{ section.id }} {
    text-align: center;
    padding: 80px 20px;
    font-family: var(--bc-font-h);
    font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bc-muted);
  }

  /* PAGINATION */
  .bcoll__pagination-{{ section.id }} {
    display: flex; justify-content: center; gap: 8px;
    margin-top: 60px;
    font-family: var(--bc-font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
  }
  .bcoll__pagination-{{ section.id }} a,
  .bcoll__pagination-{{ section.id }} span {
    padding: 8px 12px;
    color: var(--bc-muted);
    text-decoration: none;
  }
  .bcoll__pagination-{{ section.id }} a:hover { color: var(--bc-fg); }
  .bcoll__pagination-{{ section.id }} .page.current { color: var(--bc-fg); font-weight: 700; }

  /* REFINE DRAWER */
  .bcoll__drawer-{{ section.id }} {
    position: fixed;
    top: 0; left: 0; bottom: 0;
    width: 380px;
    max-width: 90vw;
    background: var(--bc-bg);
    /* fade only (no slide): hidden drawers stay out of the way via visibility */
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0s linear 0.2s;
    z-index: 9998;
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 24px rgba(0,0,0,0.08);
  }
  .bcoll__drawer-{{ section.id }}.is-open { opacity: 1; visibility: visible; transition: opacity 0.2s ease, visibility 0s; }

  .bcoll__overlay-{{ section.id }} {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.3);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    z-index: 9997;
  }
  .bcoll__overlay-{{ section.id }}.is-open {
    opacity: 1; pointer-events: auto;
  }

  .bcoll__drawer-head-{{ section.id }} {
    display: flex; align-items: center; justify-content: space-between;
    padding: 24px 24px 20px;
    flex-shrink: 0;
  }
  .bcoll__drawer-title-{{ section.id }} {
    font-family: var(--bc-font-h);
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    margin: 0;
  }
  .bcoll__drawer-close-{{ section.id }} {
    background: none; border: none; cursor: pointer;
    color: inherit; padding: 0;
    width: 16px; height: 16px;
    display: flex; align-items: center; justify-content: center;
  }
  .bcoll__drawer-close-{{ section.id }} svg { width: 100%; height: 100%; stroke: currentColor; fill: none; stroke-width: 2; }

  .bcoll__drawer-body-{{ section.id }} {
    flex: 1;
    overflow-y: auto;
    padding: 0 24px;
  }

  .bcoll__filter-{{ section.id }} {
    border-bottom: 1px solid var(--bc-hairline);
  }
  .bcoll__filter-head-{{ section.id }} {
    width: 100%;
    background: none; border: none;
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 0;
    cursor: pointer;
    color: inherit;
    font-family: var(--bc-font-h);
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    text-align: left;
  }
  .bcoll__filter-chev-{{ section.id }} {
    font-family: var(--bc-font-mono);
    font-size: 12px;
  }
  .bcoll__filter-{{ section.id }}.is-open .bcoll__filter-chev-{{ section.id }} { transform: rotate(45deg); }

  .bcoll__filter-body-{{ section.id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }
  .bcoll__filter-{{ section.id }}.is-open .bcoll__filter-body-{{ section.id }} { max-height: 600px; }

  .bcoll__filter-list-{{ section.id }} {
    list-style: none; margin: 0; padding: 0 0 16px;
    max-height: 320px;
    overflow-y: auto;
  }
  .bcoll__filter-list-{{ section.id }} li { margin-bottom: 8px; }
  .bcoll__filter-list-{{ section.id }} label {
    display: flex; align-items: center; gap: 10px;
    cursor: pointer;
    font-family: var(--bc-font-h);
    font-size: 10px; font-weight: 500;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--bc-muted);
    transition: color 0.15s ease;
  }
  .bcoll__filter-list-{{ section.id }} label:hover { color: var(--bc-fg); }
  .bcoll__filter-list-{{ section.id }} input[type="checkbox"] {
    appearance: none; -webkit-appearance: none;
    width: 12px; height: 12px;
    border: 1px solid var(--bc-muted);
    background: transparent;
    cursor: pointer;
    margin: 0;
    flex-shrink: 0;
  }
  .bcoll__filter-list-{{ section.id }} input[type="checkbox"]:checked {
    background: var(--bc-fg);
    border-color: var(--bc-fg);
  }
  .bcoll__filter-list-{{ section.id }} input[type="checkbox"]:checked + span { color: var(--bc-fg); }
  .bcoll__filter-count-{{ section.id }} {
    margin-left: auto;
    color: var(--bc-muted);
    font-family: var(--bc-font-mono);
    opacity: 0.7;
  }

  .bcoll__price-row-{{ section.id }} {
    display: flex; gap: 12px;
    padding: 8px 0 16px;
  }
  .bcoll__price-row-{{ section.id }} input[type="number"] {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--bc-hairline);
    color: var(--bc-fg);
    font-family: var(--bc-font-mono);
    font-size: 10px;
    padding: 6px 0;
    outline: none;
  }

  .bcoll__drawer-foot-{{ section.id }} {
    padding: 16px 24px 24px;
    border-top: 1px solid var(--bc-hairline);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .bcoll__btn-primary-{{ section.id }} {
    width: 100%;
    background: var(--bc-btn-bg);
    color: var(--bc-btn-fg);
    border: none;
    padding: 14px;
    font-family: var(--bc-font-h);
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .bcoll__btn-primary-{{ section.id }}:hover { opacity: 0.85; }
  .bcoll__btn-secondary-{{ section.id }} {
    width: 100%;
    background: transparent;
    color: var(--bc-fg);
    border: 1px solid var(--bc-fg);
    padding: 14px;
    font-family: var(--bc-font-h);
    font-size: 10px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    display: block;
  }
  .bcoll__btn-secondary-{{ section.id }}:hover { background: var(--bc-fg); color: var(--bc-bg); }

  /* MOBILE */
  @media screen and (max-width: 900px) {
    #bcoll-{{ section.id }} { padding: 60px 16px 100px; --bc-pad-x: 16px; }
    .bcoll__grid-{{ section.id }} { grid-template-columns: repeat(2, 1fr) !important; gap: 24px 12px; }
    .bcoll__header-{{ section.id }} {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: "title title" "refine count";
      gap: 16px;
      text-align: center;
    }
    .bcoll__title-wrap-{{ section.id }} { grid-area: title; }
    .bcoll__refine-{{ section.id }} { grid-area: refine; justify-self: start; }
    .bcoll__count-{{ section.id }} { grid-area: count; justify-self: end; padding-top: 0; align-self: center; }
  }

  /* BANNER: full-width video + centred intro, directly under the logo */
  .bcoll__banner-{{ section.id }} {
    margin: 0 calc(var(--bc-pad-x) * -1) 40px;   /* bleeds out by exactly the page padding, desktop and phone */
    overflow: hidden;
    background: #000;
  }
  .bcoll__banner-{{ section.id }} video,
  .bcoll__banner-{{ section.id }} iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: {{ section.settings.banner_height }}vh;
    max-height: {{ section.settings.banner_height }}dvh;
    object-fit: cover;
    border: 0;
  }
  .bcoll__intro-{{ section.id }} {
    max-width: 520px;
    margin: 0 auto 56px;
    text-align: center;
    font-size: var(--dz-fs-body, 12px);
    line-height: 1.9;
    letter-spacing: 0.02em;
    color: var(--bc-fg);
  }
  .bcoll__intro-{{ section.id }} > :first-child { margin-top: 0; }
  .bcoll__intro-{{ section.id }} > :last-child { margin-bottom: 0; }
  .bcoll__intro-{{ section.id }} p { margin: 0 0 1em; }
  @media screen and (max-width: 749px) {
    .bcoll__banner-{{ section.id }} { margin-bottom: 28px; }
    .bcoll__intro-{{ section.id }} { margin-bottom: 40px; }
  }

  /* SHAPE: soft corners (tokens in snippets/dauze-tokens.liquid) */
  .bcoll__btn-primary-{{ section.id }},
  .bcoll__btn-secondary-{{ section.id }} { border-radius: var(--dz-radius-sm, 8px); }
  .bcoll__card-img-{{ section.id }},
  .bcoll__card-img-{{ section.id }} img,
  .bcoll__empty-{{ section.id }} { border-radius: var(--dz-radius-md, 12px); overflow: hidden; }
  .bcoll__drawer-{{ section.id }} { border-radius: 0 var(--dz-radius-lg, 16px) var(--dz-radius-lg, 16px) 0; }
{% endstyle %}

<div id="bcoll-{{ section.id }}">

  {%- if show_video -%}
    <div class="bcoll__banner-{{ section.id }}" data-bcoll-banner>
      {%- if cv != blank -%}
        {{ cv | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, preload: 'metadata' }}
      {%- elsif section.settings.banner_video != blank -%}
        {{ section.settings.banner_video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, preload: 'metadata' }}
      {%- else -%}
        {%- assign vurl = section.settings.banner_video_url -%}
        {%- if vurl.type == 'youtube' -%}
          <iframe src="https://www.youtube.com/embed/{{ vurl.id }}?autoplay=1&mute=1&loop=1&playlist={{ vurl.id }}&controls=0&modestbranding=1&playsinline=1" title="{{ collection.title | escape }}" allow="autoplay; encrypted-media" loading="lazy"></iframe>
        {%- elsif vurl.type == 'vimeo' -%}
          <iframe src="https://player.vimeo.com/video/{{ vurl.id }}?autoplay=1&muted=1&loop=1&background=1&controls=0" title="{{ collection.title | escape }}" allow="autoplay; encrypted-media" loading="lazy"></iframe>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if show_intro -%}
    <div class="bcoll__intro-{{ section.id }}">{{ intro_html }}</div>
  {%- endif -%}

  {%- comment -%} HEADER {%- endcomment -%}
  <div class="bcoll__header-{{ section.id }}">

    <button type="button" class="bcoll__refine-{{ section.id }}" data-bcoll-open-drawer>
      {{ section.settings.refine_label }}
    </button>

    <div class="bcoll__title-wrap-{{ section.id }}">
      {%- if section.settings.show_breadcrumb -%}
        <div class="bcoll__breadcrumb-{{ section.id }}">
          <a href="{{ routes.root_url }}">{{ section.settings.home_label }}</a>
          <span class="sep">/</span>
          <span>{{ collection.title }}</span>
        </div>
      {%- endif -%}
      <h1 class="bcoll__title-{{ section.id }}">{{ collection.title }}</h1>
    </div>

    <div class="bcoll__count-{{ section.id }}">{{ collection.products_count }} ITEMS</div>

  </div>

  {%- comment -%} GRID {%- endcomment -%}
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- if collection.products.size > 0 -%}
      <div class="bcoll__grid-{{ section.id }}">
        {%- for product in collection.products -%}
          {%- assign primary_img = product.featured_image -%}
          {%- assign hover_img = product.images[1] -%}
          {%- assign on_sale = false -%}
          {%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}

          <a class="bcoll__card-{{ section.id }}" href="{{ product.url }}">
            <div class="bcoll__card-img-{{ section.id }}">
              {%- if primary_img -%}
                <img class="is-primary"
                     src="{{ primary_img | image_url: width: 800 }}"
                     alt="{{ product.title | escape }}"
                     loading="lazy"
                     width="800"
                     height="{{ 800 | divided_by: primary_img.aspect_ratio | round }}">
              {%- endif -%}
              {%- if hover_img -%}
                <img class="is-hover"
                     src="{{ hover_img | image_url: width: 800 }}"
                     alt=""
                     loading="lazy"
                     width="800"
                     height="{{ 800 | divided_by: hover_img.aspect_ratio | round }}">
              {%- endif -%}
            </div>
            <div class="bcoll__card-info-{{ section.id }}">
              <div class="bcoll__card-title-{{ section.id }}">
                <span>{{ product.title }}</span>
                {%- if section.settings.show_wishlist_icon -%}
                  <span class="bcoll__wishlist-{{ section.id }}" aria-hidden="true">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor">
                      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                    </svg>
                  </span>
                {%- endif -%}
              </div>
              <div class="bcoll__card-price-{{ section.id }} {% if on_sale %}is-sale{% endif %}">
                {{ product.price | money_without_trailing_zeros }}
                {%- if on_sale -%}
                  <span class="bcoll__card-compare-{{ section.id }}">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                {%- endif -%}
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="bcoll__empty-{{ section.id }}">
        {{ section.settings.empty_text | default: 'NO PRODUCTS MATCH THESE FILTERS' }}
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="bcoll__pagination-{{ section.id }}" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">←</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a class="page" href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <span class="page current">{{ part.title }}</span>
            {%- else -%}
              <span class="page">{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">→</a>{%- endif -%}
      </nav>
    {%- endif -%}

  {%- endpaginate -%}

  {%- comment -%} REFINE DRAWER {%- endcomment -%}
  <div class="bcoll__overlay-{{ section.id }}" data-bcoll-overlay></div>

  <aside class="bcoll__drawer-{{ section.id }}" data-bcoll-drawer aria-hidden="true">
    <div class="bcoll__drawer-head-{{ section.id }}">
      <h2 class="bcoll__drawer-title-{{ section.id }}">{{ section.settings.refine_label }}</h2>
      <button type="button" class="bcoll__drawer-close-{{ section.id }}" data-bcoll-close-drawer aria-label="Close">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <form class="bcoll__drawer-body-{{ section.id }}" data-bcoll-filter-form>

      {%- comment -%} SORT BY {%- endcomment -%}
      <div class="bcoll__filter-{{ section.id }}" data-bcoll-acc>
        <button type="button" class="bcoll__filter-head-{{ section.id }}" data-bcoll-acc-head>
          <span>SORT BY</span>
          <span class="bcoll__filter-chev-{{ section.id }}">+</span>
        </button>
        <div class="bcoll__filter-body-{{ section.id }}">
          <ul class="bcoll__filter-list-{{ section.id }}">
            {%- for option in sort_options -%}
              <li>
                <label>
                  <input type="radio" name="sort_by" value="{{ option.value }}" {% if option.value == current_sort %}checked{% endif %} style="appearance:none;-webkit-appearance:none;width:12px;height:12px;border:1px solid var(--bc-muted);border-radius:50%;cursor:pointer;margin:0;flex-shrink:0;">
                  <span>{{ option.name | upcase }}</span>
                </label>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>

      {%- comment -%} NATIVE SHOPIFY FILTERS (collection.filters) {%- endcomment -%}
      {%- for filter in filters -%}
        <div class="bcoll__filter-{{ section.id }}" data-bcoll-acc>
          <button type="button" class="bcoll__filter-head-{{ section.id }}" data-bcoll-acc-head>
            <span>{{ filter.label | upcase }}</span>
            <span class="bcoll__filter-chev-{{ section.id }}">+</span>
          </button>
          <div class="bcoll__filter-body-{{ section.id }}">

            {%- case filter.type -%}

              {%- when 'list' or 'boolean' -%}
                <ul class="bcoll__filter-list-{{ section.id }}">
                  {%- for value in filter.values -%}
                    <li>
                      <label>
                        <input type="checkbox"
                               name="{{ value.param_name }}"
                               value="{{ value.value }}"
                               {% if value.active %}checked{% endif %}
                               {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                        <span>{{ value.label | upcase }}</span>
                        <span class="bcoll__filter-count-{{ section.id }}">{{ value.count }}</span>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>

              {%- when 'price_range' -%}
                <div class="bcoll__price-row-{{ section.id }}">
                  <input type="number"
                         name="{{ filter.min_value.param_name }}"
                         value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                         placeholder="MIN"
                         min="0"
                         step="any">
                  <input type="number"
                         name="{{ filter.max_value.param_name }}"
                         value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                         placeholder="MAX"
                         min="0"
                         step="any">
                </div>

            {%- endcase -%}

          </div>
        </div>
      {%- endfor -%}

      {%- if filters.size == 0 -%}
        <p style="padding: 24px 0; font-family: var(--bc-font-h); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bc-muted);">
          No filters configured. Enable filters in Shopify admin → Online Store → Search & Discovery → Filters.
        </p>
      {%- endif -%}
    </form>

    <div class="bcoll__drawer-foot-{{ section.id }}">
      <button type="submit" class="bcoll__btn-primary-{{ section.id }}" data-bcoll-apply>SHOW RESULTS</button>
      <a class="bcoll__btn-secondary-{{ section.id }}" href="{{ collection.url }}" data-bcoll-clear>CLEAR ALL</a>
    </div>
  </aside>

</div>

<script>
  (function () {
    const root = document.getElementById('bcoll-{{ section.id }}');
    if (!root) return;

    const drawer  = root.querySelector('[data-bcoll-drawer]');
    const overlay = root.querySelector('[data-bcoll-overlay]');
    const openBtn = root.querySelector('[data-bcoll-open-drawer]');
    const closeBtn = root.querySelector('[data-bcoll-close-drawer]');
    const form    = root.querySelector('[data-bcoll-filter-form]');
    const applyBtn = root.querySelector('[data-bcoll-apply]');

    function openDrawer() {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    openBtn && openBtn.addEventListener('click', openDrawer);
    closeBtn && closeBtn.addEventListener('click', closeDrawer);
    overlay && overlay.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer();
    });

    // Accordions
    root.querySelectorAll('[data-bcoll-acc]').forEach(acc => {
      const head = acc.querySelector('[data-bcoll-acc-head]');
      if (head) head.addEventListener('click', () => acc.classList.toggle('is-open'));
    });

    // Submit: build URL with selected filter params
    function applyFilters() {
      const params = new URLSearchParams();
      // collect checked checkboxes and radios
      const inputs = form.querySelectorAll('input[name]:not([disabled])');
      inputs.forEach(inp => {
        if (inp.type === 'checkbox' && inp.checked) {
          params.append(inp.name, inp.value);
        } else if (inp.type === 'radio' && inp.checked) {
          params.set(inp.name, inp.value);
        } else if (inp.type === 'number' && inp.value !== '' && inp.value !== '0') {
          params.set(inp.name, inp.value);
        }
      });
      const base = window.location.pathname;
      const qs = params.toString();
      window.location.href = qs ? base + '?' + qs : base;
    }

    applyBtn && applyBtn.addEventListener('click', (e) => {
      e.preventDefault();
      applyFilters();
    });

    form && form.addEventListener('submit', (e) => {
      e.preventDefault();
      applyFilters();
    });
  })();

  // Banner video: visitors who asked their device for reduced motion get a paused video with controls
  (function () {
    var v = document.querySelector('#bcoll-{{ section.id }} [data-bcoll-banner] video');
    if (v && window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.pause(); v.removeAttribute('autoplay'); v.controls = true;
    }
  })();
</script>

