{% comment %}
  Global Sticky Footer
  File: snippets/global-footer.liquid
  Usage: {% render 'global-footer' %} inside <body> in layout/theme.liquid

  Renders on EVERY page including the homepage.
  Visual: floating, sticky to bottom of viewport, semi-transparent dark
  background (#0A0A0A at 30% opacity), text light.

  Layout: menu links (left) / newsletter signup (center) / social icons (right).

  Social URLs: tries Shopify theme settings first; if those are empty, falls
  back to the hard-coded variables below. Just paste your URLs into the
  fallback block if the theme settings aren't reading.
{% endcomment %}

{% liquid
  assign footer_bg          = '#0A0A0A'
  assign footer_opacity     = 0.30
  assign footer_fg          = '#ffffff'
  assign accent_color       = '#ef5000'
  assign pill_clearance     = 60
  assign font_heading       = '-apple-system, BlinkMacSystemFont, "Helvetica Neue", "Akzidenz-Grotesk", Helvetica, Arial, sans-serif'
  assign footer_menu_handle = 'footer'
  assign newsletter_placeholder = 'EMAIL ADDRESS'
  assign newsletter_success_msg = 'THANKS — CHECK YOUR INBOX'

  comment
    ===========================================================
    SOCIAL MEDIA FALLBACK
    If your theme's settings.social_*_link variables aren't
    populated (or your theme doesn't expose them), paste your
    full URLs below. Leave as blank '' to hide an icon.
    ===========================================================
  endcomment
  assign fallback_instagram = ''
  assign fallback_tiktok    = ''
  assign fallback_youtube   = ''
  assign fallback_twitter   = ''
  assign fallback_facebook  = ''
  assign fallback_pinterest = ''
  assign fallback_snapchat  = ''

  assign url_instagram = settings.social_instagram_link | default: fallback_instagram
  assign url_tiktok    = settings.social_tiktok_link    | default: fallback_tiktok
  assign url_youtube   = settings.social_youtube_link   | default: fallback_youtube
  assign url_twitter   = settings.social_twitter_link   | default: fallback_twitter
  assign url_facebook  = settings.social_facebook_link  | default: fallback_facebook
  assign url_pinterest = settings.social_pinterest_link | default: fallback_pinterest
  assign url_snapchat  = settings.social_snapchat_link  | default: fallback_snapchat
%}

{% style %}
  body {
    padding-bottom: calc(60px + {{ pill_clearance }}px);
  }

  .gf {
    position: fixed;
    left: 0; right: 0;
    bottom: 0;
    z-index: 99;
    padding: 18px 5vw;
    padding-bottom: calc(18px + {{ pill_clearance }}px);
    color: {{ footer_fg }};
    pointer-events: none;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .gf::before {
    content: "";
    position: absolute; inset: 0;
    background: {{ footer_bg }};
    opacity: {{ footer_opacity }};
    z-index: -1;
  }

  .gf__inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 1600px;
    margin: 0 auto;
    font-family: {{ font_heading }};
    font-size: 11px;
  }

  /* Row 1: menu spread across full width, single line */
  .gf__menu {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    list-style: none;
    margin: 0; padding: 0;
    pointer-events: auto;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
  }
  .gf__menu::-webkit-scrollbar { display: none; }
  .gf__menu a {
    color: inherit;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .gf__menu a:hover { color: {{ accent_color }}; }

  /* Row 2: copyright left, newsletter center, socials right */
  .gf__row2 {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  .gf__copyright {
    font-family: {{ font_heading }};
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.7;
    justify-self: start;
    pointer-events: auto;
  }

  .gf__newsletter {
    display: flex; align-items: center; gap: 6px;
    justify-self: center;
    pointer-events: auto;
  }
  .gf__newsletter input[type="email"] {
    background: transparent;
    border: none;
    border-bottom: 1px solid currentColor;
    color: inherit;
    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 4px;
    width: 220px;
    outline: none;
  }
  .gf__newsletter input[type="email"]::placeholder {
    color: inherit; opacity: 0.5;
  }
  .gf__newsletter input[type="email"]:focus {
    border-bottom-color: {{ accent_color }};
  }
  .gf__newsletter button {
    background: transparent;
    border: none;
    color: inherit;
    font-family: inherit;
    font-size: 14px;
    cursor: pointer;
    padding: 6px 4px;
    line-height: 1;
  }
  .gf__newsletter button:hover { color: {{ accent_color }}; }
  .gf__news-msg {
    margin-left: 10px;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .gf__news-msg.is-success { color: {{ accent_color }}; opacity: 1; }

  .gf__socials {
    display: flex;
    gap: 14px;
    justify-content: flex-end;
    align-items: center;
    justify-self: end;
    pointer-events: auto;
  }
  .gf__socials a {
    color: inherit;
    width: 18px; height: 18px;
    display: inline-flex;
    align-items: center; justify-content: center;
    transition: opacity 0.2s ease;
  }
  .gf__socials a:hover { opacity: 0.6; }
  .gf__socials svg {
    width: 100%; height: 100%;
    fill: currentColor;
  }

  @media screen and (max-width: 900px) {
    .gf__menu {
      gap: 12px 18px;
      flex-wrap: wrap;
      justify-content: center;
      white-space: normal;
      overflow-x: visible;
    }
    .gf__menu a { font-size: 10px; }
    .gf__row2 {
      grid-template-columns: 1fr;
      gap: 12px;
      text-align: center;
    }
    .gf__copyright,
    .gf__newsletter,
    .gf__socials { justify-self: center; }
    .gf__newsletter input[type="email"] { width: 200px; }
  }
{% endstyle %}

<footer class="gf" role="contentinfo">
  <div class="gf__inner">

    <ul class="gf__menu">
      {%- if linklists[footer_menu_handle] != blank -%}
        {%- for link in linklists[footer_menu_handle].links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    <div class="gf__row2">

      <div class="gf__copyright">&copy; {{ shop.name }}</div>

      {%- form 'customer', class: 'gf__newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email"
               name="contact[email]"
               placeholder="{{ newsletter_placeholder }}"
               aria-label="Email"
               required
               autocomplete="email">
        <button type="submit" aria-label="Subscribe">→</button>

        {%- if form.posted_successfully? -%}
          <span class="gf__news-msg is-success">{{ newsletter_success_msg }}</span>
        {%- elsif form.errors -%}
          <span class="gf__news-msg">{{ form.errors | default_errors }}</span>
        {%- endif -%}
      {%- endform -%}

      <div class="gf__socials">
      {%- if url_instagram != blank -%}
