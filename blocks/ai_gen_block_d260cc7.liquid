{% doc %}
  @prompt
    make the current  recommended products section autonomated, horizontal, automated, moving left to right, full-width

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-auto-carousel-{{ ai_gen_id }} {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
    overflow: hidden;
  }

  .ai-auto-carousel__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-auto-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 32px;
  }

  .ai-auto-carousel__title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 8px;
    text-transform: {{ block.settings.heading_case }};
  }

  .ai-auto-carousel__subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0;
  }

  .ai-auto-carousel__track-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin: 0 -20px;
  }

  .ai-auto-carousel__track-{{ ai_gen_id }} {
    display: flex;
    animation: ai-auto-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    gap: {{ block.settings.card_gap }}px;
    will-change: transform;
  }

  .ai-auto-carousel__track-{{ ai_gen_id }}:hover {
    animation-play-state: {{ block.settings.pause_on_hover | default: true | ternary: 'paused', 'running' }};
  }

  @keyframes ai-auto-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-100% - {{ block.settings.card_gap }}px));
    }
  }

  .ai-auto-carousel__product-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 16px;
    text-align: center;
    border: 1px solid {{ block.settings.card_border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-auto-carousel__product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .ai-auto-carousel__product-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    margin-bottom: 12px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-auto-carousel__product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-auto-carousel__product-title-{{ ai_gen_id }} {
    color: {{ block.settings.product_title_color }};
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 8px;
    text-decoration: none;
    display: block;
    line-height: 1.3;
    height: 2.6em;
    overflow: hidden;
  }

  .ai-auto-carousel__product-title-{{ ai_gen_id }}:hover {
    color: {{ block.settings.primary_color }};
  }

  .ai-auto-carousel__product-price-{{ ai_gen_id }} {
    color: {{ block.settings.price_color }};
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 12px;
  }

  .ai-auto-carousel__add-to-cart-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    padding: 10px 16px;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-weight: 600;
    font-size: 12px;
    transition: background-color 0.3s ease;
    width: 100%;
  }

  .ai-auto-carousel__add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-auto-carousel__add-to-cart-{{ ai_gen_id }}:disabled {
    background-color: #cccccc;
    cursor: not-allowed;
  }

  .ai-auto-carousel__loading-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px;
    color: {{ block.settings.text_color }};
  }

  .ai-auto-carousel__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px;
    color: #999;
    font-style: italic;
  }

  .ai-auto-carousel__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 12px;
  }

  @media screen and (max-width: 749px) {
    .ai-auto-carousel__container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-auto-carousel__track-wrapper-{{ ai_gen_id }} {
      margin: 0 -16px;
    }

    .ai-auto-carousel__product-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width | times: 0.8 }}px;
    }

    .ai-auto-carousel__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-auto-carousel-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 0;
    }
  }
{% endstyle %}

<auto-carousel-{{ ai_gen_id }}
  class="ai-auto-carousel-{{ ai_gen_id }}"
  data-product-id="{{ product.id }}"
  data-collection-id="{{ collection.id }}"
  data-limit="{{ block.settings.products_limit }}"
  data-algorithm="{{ block.settings.recommendation_algorithm }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-auto-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.show_heading %}
      <div class="ai-auto-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-auto-carousel__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-auto-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="ai-auto-carousel__loading-{{ ai_gen_id }}" id="loading-{{ ai_gen_id }}">
    Loading recommendations...
  </div>

  <div class="ai-auto-carousel__track-wrapper-{{ ai_gen_id }}" id="track-wrapper-{{ ai_gen_id }}" style="display: none;">
    <div class="ai-auto-carousel__track-{{ ai_gen_id }}" id="products-track-{{ ai_gen_id }}">
    </div>
  </div>

  <div class="ai-auto-carousel__empty-{{ ai_gen_id }}" id="empty-state-{{ ai_gen_id }}" style="display: none;">
    <div class="ai-auto-carousel__container-{{ ai_gen_id }}">
      No recommendations available at this time.
    </div>
  </div>
</auto-carousel-{{ ai_gen_id }}>

<script>
(function() {
  class AutoCarousel{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.productId = this.dataset.productId;
      this.collectionId = this.dataset.collectionId;
      this.limit = parseInt(this.dataset.limit) || 12;
      this.algorithm = this.dataset.algorithm;
      this.loadingEl = this.querySelector('#loading-{{ ai_gen_id }}');
      this.trackWrapperEl = this.querySelector('#track-wrapper-{{ ai_gen_id }}');
      this.trackEl = this.querySelector('#products-track-{{ ai_gen_id }}');
      this.emptyEl = this.querySelector('#empty-state-{{ ai_gen_id }}');
    }

    connectedCallback() {
      this.loadRecommendations();
    }

    async loadRecommendations() {
      try {
        let products = [];
        
        if (this.algorithm === 'related' && this.productId) {
          products = await this.fetchRelatedProducts();
        } else if (this.algorithm === 'popular') {
          products = await this.fetchPopularProducts();
        } else if (this.algorithm === 'recent') {
          products = await this.fetchRecentProducts();
        } else {
          products = await this.fetchFallbackProducts();
        }

        this.renderProducts(products);
      } catch (error) {
        console.error('Error loading recommendations:', error);
        this.showEmptyState();
      }
    }

    async fetchRelatedProducts() {
      try {
        const response = await fetch(`/recommendations/products.json?product_id=${this.productId}&limit=${this.limit}`);
        if (!response.ok) throw new Error('Failed to fetch related products');
        const data = await response.json();
        return data.products || [];
      } catch (error) {
        return this.fetchFallbackProducts();
      }
    }

    async fetchPopularProducts() {
      try {
        const response = await fetch(`/collections/all/products.json?limit=${this.limit}&sort_by=best-selling`);
        if (!response.ok) throw new Error('Failed to fetch popular products');
        const data = await response.json();
        return data.products || [];
      } catch (error) {
        return this.fetchFallbackProducts();
      }
    }

    async fetchRecentProducts() {
      try {
        const response = await fetch(`/collections/all/products.json?limit=${this.limit}&sort_by=created-descending`);
        if (!response.ok) throw new Error('Failed to fetch recent products');
        const data = await response.json();
        return data.products || [];
      } catch (error) {
        return this.fetchFallbackProducts();
      }
    }

    async fetchFallbackProducts() {
      try {
        const response = await fetch(`/collections/all/products.json?limit=${this.limit}`);
        if (!response.ok) throw new Error('Failed to fetch fallback products');
        const data = await response.json();
        return data.products || [];
      } catch (error) {
        return [];
      }
    }

    renderProducts(products) {
      this.loadingEl.style.display = 'none';

      if (!products || products.length === 0) {
        this.showEmptyState();
        return;
      }

      const duplicatedProducts = [...products, ...products];
      this.trackEl.innerHTML = duplicatedProducts.map(product => this.createProductCard(product)).join('');
      this.trackWrapperEl.style.display = 'block';
      this.setupAddToCartButtons();
    }

    createProductCard(product) {
      const variant = product.variants[0];
      const price = variant ? this.formatMoney(variant.price) : 'Unavailable';
      const available = variant ? variant.available : false;
      const imageUrl = product.featured_image ? product.featured_image : '';

      return `
        <div class="ai-auto-carousel__product-card-{{ ai_gen_id }}">
          <div class="ai-auto-carousel__product-image-{{ ai_gen_id }}">
            ${imageUrl ? 
              `<img src="${imageUrl}" alt="${product.title}" loading="lazy">` : 
              `<div class="ai-auto-carousel__image-placeholder-{{ ai_gen_id }}">No image</div>`
            }
          </div>
          <a href="/products/${product.handle}" class="ai-auto-carousel__product-title-{{ ai_gen_id }}">
            ${product.title}
          </a>
          <div class="ai-auto-carousel__product-price-{{ ai_gen_id }}">
            ${price}
          </div>
          <button 
            class="ai-auto-carousel__add-to-cart-{{ ai_gen_id }}"
            data-variant-id="${variant ? variant.id : ''}"
            ${!available ? 'disabled' : ''}
          >
            ${available ? 'Add to cart' : 'Sold out'}
          </button>
        </div>
      `;
    }

    setupAddToCartButtons() {
      const buttons = this.querySelectorAll('.ai-auto-carousel__add-to-cart-{{ ai_gen_id }}');
      buttons.forEach(button => {
        button.addEventListener('click', (e) => {
          const variantId = e.target.dataset.variantId;
          if (variantId && !e.target.disabled) {
            this.addToCart(variantId, e.target);
          }
        });
      });
    }

    async addToCart(variantId, button) {
      const originalText = button.textContent;
      button.textContent = 'Adding...';
      button.disabled = true;

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        });

        if (response.ok) {
          button.textContent = 'Added!';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);

          document.dispatchEvent(new CustomEvent('cart:refresh'));
        } else {
          throw new Error('Failed to add to cart');
        }
      } catch (error) {
        console.error('Error adding to cart:', error);
        button.textContent = 'Error';
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 2000);
      }
    }

    formatMoney(cents) {
      return (cents / 100).toLocaleString('en-US', {
        style: 'currency',
        currency: 'USD'
      });
    }

    showEmptyState() {
      this.loadingEl.style.display = 'none';
      this.emptyEl.style.display = 'block';
    }
  }

  customElements.define('auto-carousel-{{ ai_gen_id }}', AutoCarousel{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Auto carousel",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You might also like"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "select",
      "id": "recommendation_algorithm",
      "label": "Recommendation type",
      "options": [
        {
          "value": "related",
          "label": "Related products"
        },
        {
          "value": "popular",
          "label": "Popular products"
        },
        {
          "value": "recent",
          "label": "Recent products"
        }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "products_limit",
