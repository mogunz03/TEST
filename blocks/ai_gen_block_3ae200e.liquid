{% doc %}
  @prompt
    wiithout changing any content, just make the head menu glassmorphic and always stick and on top
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glassmorphic-header-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: {{ block.settings.glass_background_color | color_modify: 'alpha', block.settings.glass_opacity }};
    backdrop-filter: blur({{ block.settings.blur_intensity }}px);
    -webkit-backdrop-filter: blur({{ block.settings.blur_intensity }}px);
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color | color_modify: 'alpha', block.settings.border_opacity }};
    transition: all 0.3s ease;
  }

  .ai-glassmorphic-header-{{ ai_gen_id }}.scrolled {
    background: {{ block.settings.glass_background_color | color_modify: 'alpha', block.settings.scrolled_glass_opacity }};
    backdrop-filter: blur({{ block.settings.scrolled_blur_intensity }}px);
    -webkit-backdrop-filter: blur({{ block.settings.scrolled_blur_intensity }}px);
    box-shadow: 0 4px 20px {{ block.settings.shadow_color | color_modify: 'alpha', block.settings.shadow_opacity }};
  }

  .ai-glassmorphic-header-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ai-glassmorphic-header-logo-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
  }

  .ai-glassmorphic-header-logo-{{ ai_gen_id }} img {
    height: {{ block.settings.logo_height }}px;
    width: auto;
  }

  .ai-glassmorphic-header-logo-{{ ai_gen_id }} .logo-text {
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: {{ block.settings.logo_text_size }}px;
    font-weight: {{ settings.type_heading_font.weight }};
    color: {{ block.settings.text_color }};
    text-decoration: none;
    text-transform: {{ settings.type_case_h3 }};
  }

  .ai-glassmorphic-header-nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.nav_spacing }}px;
  }

  .ai-glassmorphic-header-nav-{{ ai_gen_id }} a {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: {{ block.settings.nav_font_size }}px;
    font-weight: {{ settings.type_body_font.weight }};
    color: {{ block.settings.text_color }};
    text-decoration: none;
    padding: 8px 16px;
    border-radius: {{ block.settings.nav_border_radius }}px;
    transition: all 0.3s ease;
    position: relative;
  }

  .ai-glassmorphic-header-nav-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.text_hover_color }};
    background: {{ block.settings.nav_hover_background | color_modify: 'alpha', block.settings.nav_hover_opacity }};
  }

  .ai-glassmorphic-header-actions-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ai-glassmorphic-header-search-{{ ai_gen_id }},
  .ai-glassmorphic-header-cart-{{ ai_gen_id }},
  .ai-glassmorphic-header-account-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: {{ block.settings.icon_background | color_modify: 'alpha', block.settings.icon_background_opacity }};
    color: {{ block.settings.text_color }};
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .ai-glassmorphic-header-search-{{ ai_gen_id }}:hover,
  .ai-glassmorphic-header-cart-{{ ai_gen_id }}:hover,
  .ai-glassmorphic-header-account-{{ ai_gen_id }}:hover {
    background: {{ block.settings.icon_hover_background | color_modify: 'alpha', block.settings.icon_hover_opacity }};
    color: {{ block.settings.text_hover_color }};
    transform: scale(1.1);
  }

  .ai-glassmorphic-header-mobile-toggle-{{ ai_gen_id }} {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .ai-glassmorphic-header-mobile-toggle-{{ ai_gen_id }} span {
    width: 24px;
    height: 2px;
    background: {{ block.settings.text_color }};
    transition: all 0.3s ease;
  }

  .ai-glassmorphic-header-mobile-nav-{{ ai_gen_id }} {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: {{ block.settings.mobile_nav_background | color_modify: 'alpha', block.settings.mobile_nav_opacity }};
    backdrop-filter: blur({{ block.settings.mobile_blur_intensity }}px);
    -webkit-backdrop-filter: blur({{ block.settings.mobile_blur_intensity }}px);
    border-bottom: 1px solid {{ block.settings.border_color | color_modify: 'alpha', block.settings.border_opacity }};
    padding: 20px;
  }

  .ai-glassmorphic-header-mobile-nav-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-glassmorphic-header-mobile-nav-{{ ai_gen_id }} a {
    display: block;
    padding: 12px 0;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: {{ block.settings.nav_font_size }}px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    border-bottom: 1px solid {{ block.settings.border_color | color_modify: 'alpha', 0.1 }};
  }

  .ai-glassmorphic-header-mobile-nav-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.text_hover_color }};
  }

  body.ai-header-offset-{{ ai_gen_id }} {
    padding-top: {{ block.settings.header_height }}px;
  }

  @media screen and (max-width: 768px) {
    .ai-glassmorphic-header-nav-{{ ai_gen_id }} {
      display: none;
    }

    .ai-glassmorphic-header-mobile-toggle-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-glassmorphic-header-container-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_vertical_padding }}px {{ block.settings.mobile_horizontal_padding }}px;
    }

    .ai-glassmorphic-header-logo-{{ ai_gen_id }} img {
      height: {{ block.settings.mobile_logo_height }}px;
    }

    .ai-glassmorphic-header-logo-{{ ai_gen_id }} .logo-text {
      font-size: {{ block.settings.mobile_logo_text_size }}px;
    }
  }
{% endstyle %}

<glassmorphic-header-{{ ai_gen_id }}
  class="ai-glassmorphic-header-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-glassmorphic-header-container-{{ ai_gen_id }}">
    <div class="ai-glassmorphic-header-logo-{{ ai_gen_id }}">
      {% if block.settings.logo_image %}
        <a href="{{ routes.root_url }}">
          <img
            src="{{ block.settings.logo_image | image_url: width: 400 }}"
            alt="{{ shop.name | escape }}"
            width="{{ block.settings.logo_image.width }}"
            height="{{ block.settings.logo_image.height }}"
            loading="lazy"
          >
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" class="logo-text">
          {{ block.settings.logo_text | default: shop.name }}
        </a>
      {% endif %}
    </div>

    <nav class="ai-glassmorphic-header-nav-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign link_key = 'nav_link_' | append: i
          assign text_key = 'nav_text_' | append: i
          assign link_url = block.settings[link_key]
          assign link_text = block.settings[text_key]
        %}
        {% if link_text != blank %}
          <a href="{{ link_url | default: '#' }}">{{ link_text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="ai-glassmorphic-header-actions-{{ ai_gen_id }}">
      {% if block.settings.show_search %}
        <a href="{{ routes.search_url }}" class="ai-glassmorphic-header-search-{{ ai_gen_id }}" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </a>
      {% endif %}

      {% if block.settings.show_account %}
        <a href="{{ routes.account_url }}" class="ai-glassmorphic-header-account-{{ ai_gen_id }}" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      {% endif %}

      {% if block.settings.show_cart %}
        <a href="{{ routes.cart_url }}" class="ai-glassmorphic-header-cart-{{ ai_gen_id }}" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 22C9.55228 22 10 21.5523 10 21C10 20.4477 9.55228 20 9 20C8.44772 20 8 20.4477 8 21C8 21.5523 8.44772 22 9 22Z"></path>
            <path d="M20 22C20.5523 22 21 21.5523 21 21C21 20.4477 20.5523 20 20 20C19.4477 20 19 20.4477 19 21C19 21.5523 19.4477 22 20 22Z"></path>
            <path d="M1 1H5L7.68 14.39C7.77144 14.8504 8.02191 15.264 8.38755 15.5583C8.75318 15.8526 9.2107 16.009 9.68 16H19.4C19.8693 16.009 20.3268 15.8526 20.6925 15.5583C21.0581 15.264 21.3086 14.8504 21.4 14.39L23 6H6"></path>
          </svg>
        </a>
      {% endif %}

      <button class="ai-glassmorphic-header-mobile-toggle-{{ ai_gen_id }}" aria-label="Toggle mobile menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="ai-glassmorphic-header-mobile-nav-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign link_key = 'nav_link_' | append: i
        assign text_key = 'nav_text_' | append: i
        assign link_url = block.settings[link_key]
        assign link_text = block.settings[text_key]
      %}
      {% if link_text != blank %}
        <a href="{{ link_url | default: '#' }}">{{ link_text }}</a>
      {% endif %}
    {% endfor %}
  </div>
</glassmorphic-header-{{ ai_gen_id }}>

<script>
  (function() {
    class GlassmorphicHeader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.header = this;
        this.mobileToggle = this.querySelector('.ai-glassmorphic-header-mobile-toggle-{{ ai_gen_id }}');
        this.mobileNav = this.querySelector('.ai-glassmorphic-header-mobile-nav-{{ ai_gen_id }}');
        this.scrollThreshold = 50;
      }

      connectedCallback() {
        this.setupScrollEffect();
        this.setupMobileMenu();
        this.addBodyOffset();
      }

      setupScrollEffect() {
        let ticking = false;

        const updateHeader = () => {
          const scrollY = window.scrollY;
          
          if (scrollY > this.scrollThreshold) {
            this.header.classList.add('scrolled');
          } else {
            this.header.classList.remove('scrolled');
          }
          
          ticking = false;
        };

        const requestTick = () => {
          if (!ticking) {
            requestAnimationFrame(updateHeader);
            ticking = true;
          }
        };

        window.addEventListener('scroll', requestTick, { passive: true });
        updateHeader();
      }

      setupMobileMenu() {
        if (this.mobileToggle && this.mobileNav) {
          this.mobileToggle.addEventListener('click', () => {
            this.mobileNav.classList.toggle('active');
            
            const isOpen = this.mobileNav.classList.contains('active');
            this.mobileToggle.setAttribute('aria-expanded', isOpen);
            
            const spans = this.mobileToggle.querySelectorAll('span');
            if (isOpen) {
              spans[0].style.transform = 'rotate(45deg) translate(5px, 5px)';
              spans[1].style.opacity = '0';
              spans[2].style.transform = 'rotate(-45deg) translate(7px, -6px)';
            } else {
              spans.forEach(span => {
                span.style.transform = '';
                span.style.opacity = '';
              });
            }
          });

          document.addEventListener('click', (event) => {
            if (!this.contains(event.target)) {
              this.mobileNav.classList.remove('active');
              this.mobileToggle.setAttribute('aria-expanded', 'false');
              
              const spans = this.mobileToggle.querySelectorAll('span');
              spans.forEach(span => {
                span.style.transform = '';
                span.style.opacity = '';
              });
            }
          }
        }
      }

      addBodyOffset() {
        document.body.classList.add('ai-header-offset-{{ ai_gen_id }}');
      }

      disconnectedCallback() {
        document.body.classList.remove('ai-header-offset-{{ ai_gen_id }}');
      }
    }

    customElements.define('glassmorphic-header-{{ ai_gen_id }}', GlassmorphicHeader{{ ai_gen_id }});
  })();
</script>

