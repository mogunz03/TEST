      "label": "Section title size",
      "default": 18
    },
    {
      "type": "range",
      "id": "title_margin",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Title bottom margin",
      "default": 20
    },
    {
      "type": "range",
      "id": "product_title_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Product title size",
      "default": 14
    },
    {
      "type": "range",
      "id": "product_price_size",
