{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-carousel-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-marquee-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 30px;
    padding: 0 20px;
  }

  .ai-marquee-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
  }

  .ai-marquee-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-marquee-carousel__track-{{ ai_gen_id }} {
    display: flex;
    width: calc(200% + 40px);
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    gap: 20px;
  }

  {% if block.settings.pause_on_hover %}
    .ai-marquee-carousel__track-{{ ai_gen_id }}:hover {
      animation-play-state: paused;
    }
  {% endif %}

  .ai-marquee-carousel__item-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
    box-shadow: none;
  }

  .ai-marquee-carousel__item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-marquee-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-marquee-carousel__image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
  }

  .ai-marquee-carousel__primary-image-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
  }

  .ai-marquee-carousel__secondary-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    z-index: 2;
  }

  {% if block.settings.show_second_image_on_hover %}
    .ai-marquee-carousel__item-{{ ai_gen_id }}:hover .ai-marquee-carousel__primary-image-{{ ai_gen_id }} {
      opacity: 0;
    }

    .ai-marquee-carousel__item-{{ ai_gen_id }}:hover .ai-marquee-carousel__secondary-image-{{ ai_gen_id }} {
      opacity: 1;
    }
  {% endif %}

  .ai-marquee-carousel__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-marquee-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-marquee-carousel__content-{{ ai_gen_id }} {
    padding: 15px;
  }

  .ai-marquee-carousel__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-marquee-carousel__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 700;
    margin: 0 0 10px;
  }

  .ai-marquee-carousel__product-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: 8px 16px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    transition: background-color 0.3s ease;
  }

  .ai-marquee-carousel__product-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-marquee-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-marquee-carousel__empty-state-{{ ai_gen_id }} h3 {
    margin: 0 0 10px;
    font-size: 18px;
  }

  .ai-marquee-carousel__empty-state-{{ ai_gen_id }} p {
    margin: 0;
    font-size: 14px;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width | times: 0.8 }}px;
    }

    .ai-marquee-carousel__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-marquee-carousel__track-{{ ai_gen_id }} {
      animation-duration: {{ block.settings.scroll_speed | times: 1.5 }}s;
    }
  }
{% endstyle %}

<div class="ai-marquee-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.subtitle != blank %}
    <div class="ai-marquee-carousel__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-marquee-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-marquee-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.product_list != blank %}
    <div class="ai-marquee-carousel__track-{{ ai_gen_id }}">
      {% for product in block.settings.product_list %}
        <div class="ai-marquee-carousel__item-{{ ai_gen_id }}">
          <div class="ai-marquee-carousel__image-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 400 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="400"
                height="{{ block.settings.image_height }}"
                class="ai-marquee-carousel__primary-image-{{ ai_gen_id }}"
              >
              {% if block.settings.show_second_image_on_hover and product.images[1] %}
                <img
                  src="{{ product.images[1] | image_url: width: 400 }}"
                  alt="{{ product.images[1].alt | escape }}"
                  loading="lazy"
                  width="400"
                  height="{{ block.settings.image_height }}"
                  class="ai-marquee-carousel__secondary-image-{{ ai_gen_id }}"
                >
              {% endif %}
            {% else %}
              <div class="ai-marquee-carousel__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-marquee-carousel__content-{{ ai_gen_id }}">
            <h3 class="ai-marquee-carousel__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
            <div class="ai-marquee-carousel__product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
            <a href="{{ product.url }}" class="ai-marquee-carousel__product-link-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          </div>
        </div>
      {% endfor %}

      {% for product in block.settings.product_list %}
        <div class="ai-marquee-carousel__item-{{ ai_gen_id }}">
          <div class="ai-marquee-carousel__image-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 400 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="400"
                height="{{ block.settings.image_height }}"
                class="ai-marquee-carousel__primary-image-{{ ai_gen_id }}"
              >
              {% if block.settings.show_second_image_on_hover and product.images[1] %}
                <img
                  src="{{ product.images[1] | image_url: width: 400 }}"
                  alt="{{ product.images[1].alt | escape }}"
                  loading="lazy"
                  width="400"
                  height="{{ block.settings.image_height }}"
                  class="ai-marquee-carousel__secondary-image-{{ ai_gen_id }}"
                >
              {% endif %}
            {% else %}
              <div class="ai-marquee-carousel__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-marquee-carousel__content-{{ ai_gen_id }}">
            <h3 class="ai-marquee-carousel__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
            <div class="ai-marquee-carousel__product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
            <a href="{{ product.url }}" class="ai-marquee-carousel__product-link-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-marquee-carousel__empty-state-{{ ai_gen_id }}">
      <h3>No products selected</h3>
      <p>Add products to display in the marquee carousel</p>
    </div>
  {% endif %}
</div>

