{% doc %}
  @prompt
    Design a highly professional and photography-focused Shopify homepage that functions as a sophisticated gallery and lookbook, modeled after the aesthetic and grid layout of unveil.fr.
    
    Focus on these key elements:
    
    Grid Layout: Implement a structured, minimalist grid system for showcasing product photography and campaign imagery (like the 'Projects' section). Each product/photo block must be large and clean.
    
    Typography & Aesthetic: Use a refined, modern sans-serif typeface for all elements. Maintain a clean, monochromatic background (white or light gray) to maximize the visual impact of the photos.
    
    Minimal Interaction: Utilize subtle hover effects that reveal minimal project/product titles and categories, keeping the focus purely on the visuals until interaction.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-photo-gallery-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-photo-gallery-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-photo-gallery-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.grid_gap | times: 2 }}px;
  }

  .ai-photo-gallery-title-{{ ai_gen_id }} {
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-weight: {{ settings.type_heading_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.grid_gap }}px;
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    text-transform: {{ block.settings.title_case }};
    line-height: 1.2;
  }

  .ai-photo-gallery-subtitle-{{ ai_gen_id }} {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    opacity: 0.8;
    line-height: 1.4;
  }

  .ai-photo-gallery-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_gap | times: 2 }}px;
  }

  .ai-photo-gallery-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    background-color: {{ block.settings.item_background }};
    aspect-ratio: {{ block.settings.aspect_ratio }};
    cursor: pointer;
    transition: all {{ block.settings.hover_duration }}ms ease;
  }

  .ai-photo-gallery-item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
  }

  .ai-photo-gallery-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all {{ block.settings.hover_duration }}ms ease;
  }

  .ai-photo-gallery-item-{{ ai_gen_id }}:hover .ai-photo-gallery-image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.image_scale | divided_by: 100.0 | plus: 1 }});
  }

  .ai-photo-gallery-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      transparent 60%,
      {{ block.settings.overlay_color }} 100%
    );
    opacity: 0;
    transition: opacity {{ block.settings.hover_duration }}ms ease;
    display: flex;
    align-items: flex-end;
    padding: {{ block.settings.overlay_padding }}px;
  }

  .ai-photo-gallery-item-{{ ai_gen_id }}:hover .ai-photo-gallery-overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-photo-gallery-content-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
    width: 100%;
  }

  .ai-photo-gallery-item-title-{{ ai_gen_id }} {
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-weight: {{ settings.type_heading_font.weight }};
    font-size: {{ block.settings.item_title_size }}px;
    margin: 0 0 {{ block.settings.overlay_padding | divided_by: 4 }}px;
    text-transform: {{ block.settings.item_title_case }};
    letter-spacing: {{ block.settings.item_title_letter_spacing }}px;
    line-height: 1.3;
  }

  .ai-photo-gallery-item-category-{{ ai_gen_id }} {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-size: {{ block.settings.item_category_size }}px;
    margin: 0;
    opacity: 0.9;
    text-transform: {{ block.settings.item_category_case }};
    letter-spacing: {{ block.settings.item_category_letter_spacing }}px;
    line-height: 1.2;
  }

  .ai-photo-gallery-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-photo-gallery-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
    color: {{ block.settings.text_color }};
  }

  .ai-photo-gallery-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.overlay_padding }}px;
    left: 50%;
    transform: translateX(-50%);
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 990px) {
    .ai-photo-gallery-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-photo-gallery-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-photo-gallery-container-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.horizontal_padding | times: 0.75 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-photo-gallery-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-photo-gallery-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-photo-gallery-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-photo-gallery-container-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.horizontal_padding | times: 0.5 }}px;
    }

    .ai-photo-gallery-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.75 }}px 0;
    }

    .ai-photo-gallery-item-{{ ai_gen_id }}:hover {
      transform: none;
    }

    .ai-photo-gallery-overlay-{{ ai_gen_id }} {
      opacity: 1;
      background: linear-gradient(
        180deg,
        transparent 0%,
        transparent 50%,
        {{ block.settings.overlay_color }} 100%
      );
    }
  }
{% endstyle %}

<photography-gallery-{{ ai_gen_id }}
  class="ai-photo-gallery-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-photo-gallery-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-photo-gallery-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-photo-gallery-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-photo-gallery-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-photo-gallery-grid-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign title_key = 'title_' | append: i
          assign category_key = 'category_' | append: i
          assign link_key = 'link_' | append: i

          assign item_image = block.settings[image_key]
          assign item_title = block.settings[title_key]
          assign item_category = block.settings[category_key]
          assign item_link = block.settings[link_key]
        %}

        {% if item_image != blank or item_title != blank or item_category != blank %}
          <div class="ai-photo-gallery-item-{{ ai_gen_id }}" data-item="{{ i }}">
            {% if item_link != blank %}
              <a href="{{ item_link }}" style="display: block; width: 100%; height: 100%;">
            {% endif %}

            {% if item_image != blank %}
              <img
                src="{{ item_image | image_url: width: 800 }}"
                alt="{{ item_image.alt | default: item_title | escape }}"
                class="ai-photo-gallery-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ item_image.width }}"
                height="{{ item_image.height }}"
              >
            {% else %}
              <div class="ai-photo-gallery-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-photo-gallery-empty-state-{{ ai_gen_id }}">
                  Add image {{ i }}
                </div>
              </div>
            {% endif %}

            {% if item_title != blank or item_category != blank %}
              <div class="ai-photo-gallery-overlay-{{ ai_gen_id }}">
                <div class="ai-photo-gallery-content-{{ ai_gen_id }}">
                  {% if item_title != blank %}
                    <h3 class="ai-photo-gallery-item-title-{{ ai_gen_id }}">{{ item_title }}</h3>
                  {% endif %}
                  {% if item_category != blank %}
                    <p class="ai-photo-gallery-item-category-{{ ai_gen_id }}">{{ item_category }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}

            {% if item_link != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</photography-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class PhotographyGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-photo-gallery-item-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          item.addEventListener('mouseenter', () => {
            this.handleItemHover(item, true);
          });

          item.addEventListener('mouseleave', () => {
            this.handleItemHover(item, false);
          });

          item.addEventListener('click', (e) => {
            const link = item.querySelector('a');
            if (link && !e.target.closest('a')) {
              e.preventDefault();
              link.click();
            }
          });
        });
      }

      handleItemHover(item, isHovering) {
        const overlay = item.querySelector('.ai-photo-gallery-overlay-{{ ai_gen_id }}');
        const image = item.querySelector('.ai-photo-gallery-image-{{ ai_gen_id }}');
        const scaleValue = isHovering ? ({{ block.settings.image_scale }} / 100 + 1) : 1;
        
        if (overlay) {
          overlay.style.opacity = isHovering ? '1' : '0';
        }
        
        if (image) {
          image.style.transform = `scale(${scaleValue})`;
        }
      }
    }

    customElements.define('photography-gallery-{{ ai_gen_id }}', PhotographyGallery{{ ai_gen_id }});
  })();
</script>

