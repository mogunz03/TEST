{% doc %}
  @prompt
    Design a utilitarian, minimalist, and detail-oriented Shopify homepage, modeled after the clean, efficient aesthetic of markaware.jp.
    
    Focus on a product-first layout with these specific characteristics:
    
    Strict Grid & Organization: Use a very clean, structured, uniform grid for product listings and category blocks, prioritizing clarity and organization.
    
    Typography: Use a simple, readable sans-serif font throughout, employed in an unadorned, direct, and functional manner for product names, prices, and descriptions.
    
    Color Palette: Use a foundational monochromatic scheme (white background, black text), keeping the focus entirely on the product images.
    
    Product Presentation: The main homepage content should feature a prominent 'New In' section with clear product thumbnail images, immediate visibility of the product name, price, and available sizes/colors, mirroring the site's direct product-card style.
    
    Editorial Integration: Include dedicated sections for 'Look' (lookbooks/campaigns) and 'Care Guide' / 'Sustainability' to build brand authority, styled as simple, well-defined blocks with minimal imagery."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-minimal-homepage-{{ ai_gen_id }} {
    background-color: #ffffff;
    color: #000000;
    font-family: var(--font-body--family);
    line-height: 1.4;
  }

  .ai-minimal-homepage-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-minimal-homepage-grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.section_spacing }}px;
  }

  .ai-minimal-homepage-section-title-{{ ai_gen_id }} {
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: {{ block.settings.section_title_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 {{ block.settings.title_margin }}px 0;
    color: #000000;
    border-bottom: 1px solid #e6e6e6;
    padding-bottom: 8px;
  }

  .ai-minimal-new-in-grid-{{ ai_gen_id }} {
    grid-template-columns: repeat(auto-fit, minmax({{ block.settings.product_card_width }}px, 1fr));
  }

  .ai-minimal-product-card-{{ ai_gen_id }} {
    background: #ffffff;
    border: none;
    text-align: left;
  }

  .ai-minimal-product-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    object-fit: cover;
    margin-bottom: 12px;
    background-color: #f8f8f8;
  }

  .ai-minimal-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .ai-minimal-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-minimal-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: 400;
    margin: 0 0 4px 0;
    color: #000000;
    text-transform: none;
  }

  .ai-minimal-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    font-weight: 500;
    color: #000000;
    margin: 0 0 6px 0;
  }

  .ai-minimal-product-variants-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_variants_size }}px;
    color: #666666;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .ai-minimal-editorial-grid-{{ ai_gen_id }} {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .ai-minimal-editorial-card-{{ ai_gen_id }} {
    background: #ffffff;
    border: 1px solid #e6e6e6;
    padding: {{ block.settings.editorial_padding }}px;
    text-align: left;
  }

  .ai-minimal-editorial-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    margin-bottom: 16px;
    background-color: #f8f8f8;
  }

  .ai-minimal-editorial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16/9;
    background-color: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .ai-minimal-editorial-image-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-minimal-editorial-title-{{ ai_gen_id }} {
    font-family: var(--font-heading--family);
    font-size: {{ block.settings.editorial_title_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 8px 0;
    color: #000000;
  }

  .ai-minimal-editorial-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.editorial_description_size }}px;
    line-height: 1.5;
    color: #666666;
    margin: 0 0 12px 0;
  }

  .ai-minimal-editorial-link-{{ ai_gen_id }} {
    font-family: var(--font-heading--family);
    font-size: {{ block.settings.editorial_link_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #ef5000;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .ai-minimal-editorial-link-{{ ai_gen_id }}:hover {
    border-bottom-color: #ef5000;
  }

  .ai-minimal-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666666;
    font-size: 14px;
  }

  @media screen and (max-width: 768px) {
    .ai-minimal-homepage-container-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 16px;
    }

    .ai-minimal-new-in-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-minimal-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-minimal-section-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_title_size | times: 0.8 }}px;
    }

    .ai-minimal-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_title_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-minimal-new-in-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, 1fr);
    }
  }
{% endstyle %}

<div class="ai-minimal-homepage-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-minimal-homepage-container-{{ ai_gen_id }}">
    
    {% if block.settings.show_new_in %}
      <section>
        {% if block.settings.new_in_title != blank %}
          <h2 class="ai-minimal-homepage-section-title-{{ ai_gen_id }}">{{ block.settings.new_in_title }}</h2>
        {% endif %}
        
        {% if block.settings.new_in_collection != blank %}
          <div class="ai-minimal-homepage-grid-{{ ai_gen_id }} ai-minimal-new-in-grid-{{ ai_gen_id }}">
            {% for product in block.settings.new_in_collection.products limit: block.settings.new_in_limit %}
              <div class="ai-minimal-product-card-{{ ai_gen_id }}">
                <a href="{{ product.url }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 400 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-minimal-product-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="400"
                      height="{{ 400 | divided_by: block.settings.image_aspect_ratio }}"
                    >
                  {% else %}
                    <div class="ai-minimal-product-image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </a>
                
                <h3 class="ai-minimal-product-title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>
                
                <div class="ai-minimal-product-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </div>
                
                {% if product.variants.size > 1 %}
                  <div class="ai-minimal-product-variants-{{ ai_gen_id }}">
                    {% assign variant_count = product.variants.size %}
                    {% if variant_count > 1 %}
                      {{ variant_count }} variants
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="ai-minimal-empty-state-{{ ai_gen_id }}">
            Select a collection to display new products
          </div>
        {% endif %}
      </section>
    {% endif %}

    {% if block.settings.show_editorial %}
      <section>
        {% if block.settings.editorial_title != blank %}
          <h2 class="ai-minimal-homepage-section-title-{{ ai_gen_id }}">{{ block.settings.editorial_title }}</h2>
        {% endif %}
        
        <div class="ai-minimal-homepage-grid-{{ ai_gen_id }} ai-minimal-editorial-grid-{{ ai_gen_id }}">
          {% if block.settings.show_lookbook %}
            <div class="ai-minimal-editorial-card-{{ ai_gen_id }}">
              {% if block.settings.lookbook_image %}
                <img
                  src="{{ block.settings.lookbook_image | image_url: width: 600 }}"
                  alt="{{ block.settings.lookbook_image.alt | escape }}"
                  class="ai-minimal-editorial-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="338"
                >
              {% else %}
                <div class="ai-minimal-editorial-image-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              
              <h3 class="ai-minimal-editorial-title-{{ ai_gen_id }}">
                {{ block.settings.lookbook_title | default: "Look" }}
              </h3>
              
              {% if block.settings.lookbook_description != blank %}
                <p class="ai-minimal-editorial-description-{{ ai_gen_id }}">
                  {{ block.settings.lookbook_description }}
                </p>
              {% endif %}
              
              {% if block.settings.lookbook_link != blank %}
                <a href="{{ block.settings.lookbook_link }}" class="ai-minimal-editorial-link-{{ ai_gen_id }}">
                  {{ block.settings.lookbook_link_text | default: "View lookbook" }}
                </a>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.show_care_guide %}
            <div class="ai-minimal-editorial-card-{{ ai_gen_id }}">
              {% if block.settings.care_guide_image %}
                <img
                  src="{{ block.settings.care_guide_image | image_url: width: 600 }}"
                  alt="{{ block.settings.care_guide_image.alt | escape }}"
                  class="ai-minimal-editorial-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="338"
                >
              {% else %}
                <div class="ai-minimal-editorial-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
              
              <h3 class="ai-minimal-editorial-title-{{ ai_gen_id }}">
                {{ block.settings.care_guide_title | default: "Care guide" }}
              </h3>
              
              {% if block.settings.care_guide_description != blank %}
                <p class="ai-minimal-editorial-description-{{ ai_gen_id }}">
                  {{ block.settings.care_guide_description }}
                </p>
              {% endif %}
              
              {% if block.settings.care_guide_link != blank %}
                <a href="{{ block.settings.care_guide_link }}" class="ai-minimal-editorial-link-{{ ai_gen_id }}">
                  {{ block.settings.care_guide_link_text | default: "Learn more" }}
                </a>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.show_sustainability %}
            <div class="ai-minimal-editorial-card-{{ ai_gen_id }}">
              {% if block.settings.sustainability_image %}
                <img
                  src="{{ block.settings.sustainability_image | image_url: width: 600 }}"
                  alt="{{ block.settings.sustainability_image.alt | escape }}"
                  class="ai-minimal-editorial-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="338"
                >
              {% else %}
                <div class="ai-minimal-editorial-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
              
              <h3 class="ai-minimal-editorial-title-{{ ai_gen_id }}">
                {{ block.settings.sustainability_title | default: "Sustainability" }}
              </h3>
              
              {% if block.settings.sustainability_description != blank %}
                <p class="ai-minimal-editorial-description-{{ ai_gen_id }}">
                  {{ block.settings.sustainability_description }}
                </p>
              {% endif %}
              
              {% if block.settings.sustainability_link != blank %}
                <a href="{{ block.settings.sustainability_link }}" class="ai-minimal-editorial-link-{{ ai_gen_id }}">
                  {{ block.settings.sustainability_link_text | default: "Our commitment" }}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </section>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Minimal homepage",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_spacing",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Section spacing",
      "default": 80
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid gap",
      "default": 20
    },
    {
      "type": "header",
      "content": "New in section"
    },
    {
      "type": "checkbox",
      "id": "show_new_in",
      "label": "Show new in section",
      "default": true
    },
    {
      "type": "text",
      "id": "new_in_title",
      "label": "Section title",
      "default": "New in"
    },
    {
      "type": "collection",
      "id": "new_in_collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "new_in_limit",
      "min": 4,
      "max": 12,
      "step": 2,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "range",
      "id": "product_card_width",
      "min": 200,
      "max": 350,
      "step": 10,
      "unit": "px",
      "label": "Product card minimum width",
      "default": 250
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
